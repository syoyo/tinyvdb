/-
  TinyVDB - Lean 4 formalization of the OpenVDB file format and volume operators.

  The Euler characteristic of cubical complexes: for a finite set of unit
  cubes `K ⊆ ℤ³` (by lower corner), the cell counts of the induced cubical
  complex satisfy

    `χ(K) = V − E + F − C`

  (`V` vertices, `E` edges, `F` square faces, `C` cubes). This module
  derives all cells from the cube set, so `χ` is a function of `K` alone:

  * `cellsOf K` — `(vertices, edges, faces)` of the complex, closed under
    taking faces;
  * `chiOf K := #V − #E + #F − #C`;
  * `chiOf_union` — `χ(K₁ ∪ K₂) = χ(K₁) + χ(K₂) − χ(sharedCells)`, where
    `sharedCells` is the componentwise cell intersection (inclusion–exclusion
    at each dimension), and the `K₁ ∩ K₂ = ∅` case as a corollary;
  * concrete machine-checked evaluations (`native_decide`): a single cube
    has `χ = 1`, two adjacent cubes have `χ = 1` (a 2×1×1 box), a 2×2×2
    block has `χ = 1`, and a 3×3×3 shell (26 cubes around a missing centre)
    has `χ = 2`;
  * `boundaryFaces` (faces adjacent to exactly one cube of `K`),
    `chiBoundary`, and the checked identities `χ(∂S) = 2·χ(S)` for the 2×2×2
    block and the 3×3×3 shell — the Poincaré–Lefschetz relation verified on
    two concrete solids, not proved in general.

  What is *not* proved here: the general Poincaré–Lefschetz duality, and
  any theorem about non-cubical cell structures.

  Copyright (c) 2026 Syoyo Fujita and TinyVDB authors
  SPDX-License-Identifier: Apache-2.0
-/
import Mathlib.Data.Finset.Basic
import Mathlib.Data.Finset.Union
import Mathlib.Data.Int.Basic
import Mathlib.Tactic

set_option linter.unusedSectionVars false

namespace Vdb

/-- Lattice points. -/
abbrev C3 := Int × Int × Int

/-- Unit step along axis `i`. -/
def axisVec (i : Fin 3) : C3 :=
  if i = 0 then (1, 0, 0) else if i = 1 then (0, 1, 0) else (0, 0, 1)

def addC3 (a b : C3) : C3 := (a.1 + b.1, a.2.1 + b.2.1, a.2.2 + b.2.2)
def subC3 (a b : C3) : C3 := (a.1 - b.1, a.2.1 - b.2.1, a.2.2 - b.2.2)

/-- A unit edge, as its lower endpoint and axis. -/
structure Edge3 where
  base : C3
  axis : Fin 3
deriving DecidableEq, Repr

/-- A unit square face, as its lower corner and normal axis. -/
structure Face3 where
  base : C3
  axis : Fin 3
deriving DecidableEq, Repr

/-- The two vertices of an edge. -/
def edgeVerts (e : Edge3) : Finset C3 := {e.base, addC3 e.base (axisVec e.axis)}

/-- The four corners of a face. -/
def faceCorners (f : Face3) : Finset C3 :=
  let b := axisVec ((f.axis + 1) % 3)
  let c := axisVec ((f.axis + 2) % 3)
  { f.base, addC3 f.base b, addC3 f.base c, addC3 (addC3 f.base b) c }

/-- The four edges of a face. -/
def faceEdges (f : Face3) : Finset Edge3 :=
  let b := (f.axis + 1) % 3
  let c := (f.axis + 2) % 3
  { Edge3.mk f.base b, Edge3.mk f.base c,
    Edge3.mk (addC3 f.base (axisVec b)) c,
    Edge3.mk (addC3 f.base (axisVec c)) b }

/-- The six faces of a unit cube at `c` (lower corner). -/
def cubeFaces (c : C3) : Finset Face3 :=
  { Face3.mk c 0, Face3.mk (addC3 c (axisVec 0)) 0,
    Face3.mk c 1, Face3.mk (addC3 c (axisVec 1)) 1,
    Face3.mk c 2, Face3.mk (addC3 c (axisVec 2)) 2 }

/-- The two adjacent cubes of a face (lower corners). -/
def adjacentCubes (f : Face3) : Finset C3 :=
  { f.base, subC3 f.base (axisVec f.axis) }

/-- The cells of the cubical complex generated by the cube set `K`. -/
def cellsOf (K : Finset C3) : Finset C3 × Finset Edge3 × Finset Face3 :=
  let fs := K.biUnion cubeFaces
  let es := fs.biUnion faceEdges
  let vs := es.biUnion edgeVerts
  (vs, es, fs)

/-- The Euler characteristic of the cubical complex generated by `K`. -/
def chiOf (K : Finset C3) : Int :=
  let (vs, es, fs) := cellsOf K
  (vs.card : Int) - (es.card : Int) + (fs.card : Int) - (K.card : Int)

/-- Euler characteristic of a cell tuple. -/
def chiCells (c : Finset C3 × Finset Edge3 × Finset Face3) : Int :=
  (c.1.card : Int) - (c.2.1.card : Int) + (c.2.2.card : Int)

/-- The cells shared by two cube sets' complexes (componentwise intersection). -/
def sharedCells (K₁ K₂ : Finset C3) : Finset C3 × Finset Edge3 × Finset Face3 :=
  let (v₁, e₁, f₁) := cellsOf K₁
  let (v₂, e₂, f₂) := cellsOf K₂
  (v₁ ∩ v₂, e₁ ∩ e₂, f₁ ∩ f₂)

private theorem biUnion_union_left {α β : Type*} [DecidableEq α] [DecidableEq β]
    (s t : Finset α) (f : α → Finset β) :
    (s ∪ t).biUnion f = s.biUnion f ∪ t.biUnion f := by
  ext x
  simp only [Finset.mem_biUnion, Finset.mem_union]
  constructor
  · rintro ⟨a, ha | ha, hx⟩
    · exact Or.inl ⟨a, ha, hx⟩
    · exact Or.inr ⟨a, ha, hx⟩
  · rintro (⟨a, ha, hx⟩ | ⟨a, ha, hx⟩)
    · exact ⟨a, Or.inl ha, hx⟩
    · exact ⟨a, Or.inr ha, hx⟩

private theorem biUnion_union_right {α β : Type*} [DecidableEq α] [DecidableEq β]
    (s : Finset α) (t₁ t₂ : α → Finset β) :
    s.biUnion (fun x => t₁ x ∪ t₂ x) = s.biUnion t₁ ∪ s.biUnion t₂ := by
  ext x
  simp only [Finset.mem_biUnion, Finset.mem_union]
  constructor
  · rintro ⟨a, ha, hx | hx⟩
    · exact Or.inl ⟨a, ha, hx⟩
    · exact Or.inr ⟨a, ha, hx⟩
  · rintro (⟨a, ha, hx⟩ | ⟨a, ha, hx⟩)
    · exact ⟨a, ha, Or.inl hx⟩
    · exact ⟨a, ha, Or.inr hx⟩

/-- The faces/edges/vertices generated by a union are the unions of the
    generated sets. -/
theorem cellsOf_union (K₁ K₂ : Finset C3) :
    cellsOf (K₁ ∪ K₂) =
      ((cellsOf K₁).1 ∪ (cellsOf K₂).1,
       (cellsOf K₁).2.1 ∪ (cellsOf K₂).2.1,
       (cellsOf K₁).2.2 ∪ (cellsOf K₂).2.2) := by
  have hfs : (K₁ ∪ K₂).biUnion cubeFaces =
      K₁.biUnion cubeFaces ∪ K₂.biUnion cubeFaces := biUnion_union_left _ _ _
  have hes : (K₁.biUnion cubeFaces ∪ K₂.biUnion cubeFaces).biUnion faceEdges =
      (K₁.biUnion cubeFaces).biUnion faceEdges ∪
        (K₂.biUnion cubeFaces).biUnion faceEdges := biUnion_union_left _ _ _
  have hvs : ((K₁.biUnion cubeFaces).biUnion faceEdges ∪
        (K₂.biUnion cubeFaces).biUnion faceEdges).biUnion edgeVerts =
      ((K₁.biUnion cubeFaces).biUnion faceEdges).biUnion edgeVerts ∪
        ((K₂.biUnion cubeFaces).biUnion faceEdges).biUnion edgeVerts :=
    biUnion_union_left _ _ _
  dsimp only [cellsOf]
  rw [hfs, hes, hvs]

/-- **Additivity** (inclusion–exclusion over cells):

    `χ(K₁ ∪ K₂) = χ(K₁) + χ(K₂) − χ(sharedCells K₁ K₂) + |K₁ ∩ K₂|`.

    For cubical complexes with no shared cubes but shared faces/edges/vertices
    (e.g. two adjacent cubes sharing one face), the `|K₁ ∩ K₂|` term is what
    makes the identity exact. -/
theorem chiOf_union (K₁ K₂ : Finset C3) :
    chiOf (K₁ ∪ K₂) = chiOf K₁ + chiOf K₂ - chiCells (sharedCells K₁ K₂) +
      ((K₁ ∩ K₂).card : Int) := by
  have hv' : (((cellsOf K₁).1 ∪ (cellsOf K₂).1).card + ((cellsOf K₁).1 ∩ (cellsOf K₂).1).card =
      ((cellsOf K₁).1).card + ((cellsOf K₂).1).card) := Finset.card_union_add_card_inter _ _
  have ce' : (((cellsOf K₁).2.1 ∪ (cellsOf K₂).2.1).card + ((cellsOf K₁).2.1 ∩ (cellsOf K₂).2.1).card =
      ((cellsOf K₁).2.1).card + ((cellsOf K₂).2.1).card) := Finset.card_union_add_card_inter _ _
  have cf' : (((cellsOf K₁).2.2 ∪ (cellsOf K₂).2.2).card + ((cellsOf K₁).2.2 ∩ (cellsOf K₂).2.2).card =
      ((cellsOf K₁).2.2).card + ((cellsOf K₂).2.2).card) := Finset.card_union_add_card_inter _ _
  have ck' : ((K₁ ∪ K₂).card + (K₁ ∩ K₂).card = K₁.card + K₂.card) :=
    Finset.card_union_add_card_inter _ _
  have hv'' : (((cellsOf K₁).1 ∪ (cellsOf K₂).1).card : Int) + (((cellsOf K₁).1 ∩ (cellsOf K₂).1).card : Int) =
      (((cellsOf K₁).1).card : Int) + (((cellsOf K₂).1).card : Int) := by exact_mod_cast hv'
  have ce'' : (((cellsOf K₁).2.1 ∪ (cellsOf K₂).2.1).card : Int) + (((cellsOf K₁).2.1 ∩ (cellsOf K₂).2.1).card : Int) =
      (((cellsOf K₁).2.1).card : Int) + (((cellsOf K₂).2.1).card : Int) := by exact_mod_cast ce'
  have cf'' : (((cellsOf K₁).2.2 ∪ (cellsOf K₂).2.2).card : Int) + (((cellsOf K₁).2.2 ∩ (cellsOf K₂).2.2).card : Int) =
      (((cellsOf K₁).2.2).card : Int) + (((cellsOf K₂).2.2).card : Int) := by exact_mod_cast cf'
  have ck'' : ((K₁ ∪ K₂).card : Int) + ((K₁ ∩ K₂).card : Int) = (K₁.card : Int) + (K₂.card : Int) := by
    exact_mod_cast ck'
  dsimp only [chiOf, sharedCells, chiCells]
  rw [cellsOf_union]
  simp only
  nlinarith [hv'', ce'', cf'', ck'']

/-- A complex with **no** shared cells and disjoint cube sets adds:
    `χ(K₁ ∪ K₂) = χ(K₁) + χ(K₂)`. -/
theorem chiOf_union_add (K₁ K₂ : Finset C3) (h : sharedCells K₁ K₂ = (∅, ∅, ∅))
    (hK : K₁ ∩ K₂ = ∅) :
    chiOf (K₁ ∪ K₂) = chiOf K₁ + chiOf K₂ := by
  rw [chiOf_union, h, hK]
  simp [chiCells]


/-! ### Boundary faces and the boundary Euler characteristic -/

/-- The boundary faces of `K`: faces adjacent to exactly one cube of `K`. -/
def boundaryFaces (K : Finset C3) : Finset Face3 :=
  (K.biUnion cubeFaces).filter fun f => ((adjacentCubes f) ∩ K).card = 1

/-- The cells of the boundary surface (no 3-cells). -/
def boundaryCells (K : Finset C3) : Finset C3 × Finset Edge3 × Finset Face3 :=
  let fs := boundaryFaces K
  let es := fs.biUnion faceEdges
  let vs := es.biUnion edgeVerts
  (vs, es, fs)

/-- The Euler characteristic of the boundary surface `∂K`. -/
def chiBoundary (K : Finset C3) : Int :=
  let (vs, es, fs) := boundaryCells K
  (vs.card : Int) - (es.card : Int) + (fs.card : Int)

/-- The 2×2×2 block (`8` cubes). -/
def block2 : Finset C3 :=
  ((Finset.range 2).product (Finset.range 2)).product (Finset.range 2) |>.image
    fun p => ((p.1.1 : Int), (p.1.2 : Int), (p.2 : Int))

/-- The 3×3×3 shell (all cubes of the 3³ block except the centre cube). -/
def shell3 : Finset C3 :=
  (((Finset.range 3).product (Finset.range 3)).product (Finset.range 3) |>.image
    fun p => ((p.1.1 : Int), (p.1.2 : Int), (p.2 : Int))) \
      {(1, 1, 1)}

/-- A single cube has `χ = 1`. -/
theorem chiOf_cube : chiOf {(0, 0, 0)} = 1 := by native_decide

/-- Two adjacent cubes (a 2×1×1 box) have `χ = 1`. -/
theorem chiOf_two_adjacent : chiOf {(0, 0, 0), (1, 0, 0)} = 1 := by native_decide

/-- A 2×2×2 block has `χ = 1`. -/
theorem chiOf_block2 : chiOf block2 = 1 := by native_decide

/-- The 3×3×3 shell (26 cubes) has `χ = 2` (a hollow sphere). -/
theorem chiOf_shell3 : chiOf shell3 = 2 := by native_decide

/-- The boundary of the 2×2×2 block has `χ = 2` (its surface is `S²`),
    matching `2·χ(block)`. -/
theorem chiBoundary_block2 : chiBoundary block2 = 2 := by native_decide
theorem chiBoundary_block2_eq_two_chi : chiBoundary block2 = 2 * chiOf block2 := by native_decide

/-- The boundary of the 3×3×3 shell has `χ = 4` (two spheres),
    matching `2·χ(shell)`. -/
theorem chiBoundary_shell3 : chiBoundary shell3 = 4 := by native_decide
theorem chiBoundary_shell3_eq_two_chi : chiBoundary shell3 = 2 * chiOf shell3 := by native_decide

def halfA : Finset C3 :=
  ((Finset.range 1).product ((Finset.range 2).product (Finset.range 2))).image
    fun p => (((p.1 : Int)), (p.2.1 : Int), (p.2.2 : Int))

def halfB : Finset C3 :=
  ((Finset.range 1).product ((Finset.range 2).product (Finset.range 2))).image
    fun p => (((p.1 : Int) + 1), (p.2.1 : Int), (p.2.2 : Int))

/-- A complex whose cube sets are disjoint *and* whose complexes share no
    cells adds: two separated unit cubes have `χ = 2`. -/
theorem chiOf_two_separated : chiOf {(0, 0, 0), (5, 0, 0)} = 2 := by native_decide

/-- The shared face of two adjacent cubes: `χ = 1` (4 vertices, 4 edges,
    1 face). -/
theorem sharedCells_two_adjacent :
    chiCells (sharedCells {(0, 0, 0)} {(1, 0, 0)}) = 1 := by native_decide

/-- The cube-set intersection shares no cells with the union identity:
    `χ(2×1×1) = 1 + 1 − 1 + 0`. -/
theorem chiOf_two_adjacent_add :
    chiOf {(0, 0, 0), (1, 0, 0)} = chiOf {(0, 0, 0)} + chiOf {(1, 0, 0)} -
      chiCells (sharedCells {(0, 0, 0)} {(1, 0, 0)}) := by native_decide


/-- Sanity check on additivity: the two halves of the 2×2×2 block share one
    interface layer of cells (4 faces, 12 edges, 9 vertices, χ = 1), and
    `χ(2³ block) = χ(halfA) + χ(halfB) − χ(shared) + |cubes ∩ cubes|`. -/
theorem sharedCells_block2_halves :
    ((sharedCells halfA halfB).2.2.card, (sharedCells halfA halfB).2.1.card,
      (sharedCells halfA halfB).1.card, chiCells (sharedCells halfA halfB),
      chiOf (halfA ∪ halfB)) = (4, 12, 9, 1, 1) := by
  native_decide

/-- Additivity, concretely: `χ(2³ block) = χ(halfA) + χ(halfB) − χ(shared)`. -/
theorem chiOf_block2_additivity :
    chiOf (halfA ∪ halfB) = chiOf halfA + chiOf halfB -
      chiCells (sharedCells halfA halfB) + ((halfA ∩ halfB).card : Int) :=
  chiOf_union halfA halfB

end Vdb
