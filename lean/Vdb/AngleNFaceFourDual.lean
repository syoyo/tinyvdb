/-
  TinyVDB - Lean 4 formalization of the OpenVDB (`.vdb`) file format
  and the volume operators.

  The n = 4 explicit diagonal: dual-cone containment discharged.

  For the trihedra T₁ = (n₀,n₁,m) and T₂ = (-m,n₂,n₃) of
  `Vdb/AngleNFaceFourDiagonal`, this module proves that every boundary face
  normal nⱼ (j = 0..3) lies in the cone generated by each trihedron's three
  co-normals, with at least one strictly positive coefficient.  This is exactly
  the `hdu`/`hdv` requirement (`FanTriangleTransfer`) of
  `fourDiag_face_pos_of_convex`, which is therefore recovered unconditionally
  together with the two triangle nondegeneracy facts.

  The only analytic input is the four strict convexity inequalities of the
  quadrilateral (`dot n₀ v₂₁ < 0`, `dot n₁ v₁₀ < 0`, `dot n₂ v₁₀ < 0`,
  `dot n₃ v₂₁ < 0`).  They make the ray coefficients c₀,c₁,c₂,c₃ of
  `AngleNFaceFourDiagonal` strictly positive, and the vector triple-product
  identities of that module then give the two exact cone identities

      c₁ · n₂ − c₂ · n₁ = m,        c₀ · n₃ − c₃ · n₀ = m.

  Rearranging these yields the four nontrivial containments (n₂,n₃ in cone T₁
  and n₀,n₁ in cone T₂); the four remaining ones are the trivial membership of
  a generator in its own cone.

  No existing file is modified.

  Copyright (c) 2026 Syoyo Fujita and TinyVDB authors
  SPDX-License-Identifier: Apache-2.0
 -/
import Vdb.AngleNFaceFourDiagonal
import Vdb.AngleNFaceFan

namespace Vdb
namespace V3

open scoped Real
open Real

set_option linter.unusedSectionVars false
set_option linter.unusedVariables false
set_option linter.unreachableTactic false
set_option linter.unusedSimpArgs false
set_option maxHeartbeats 800000

/-! ### 0. Local vector/dot algebra -/

lemma dual_dot_add_left (u v w : V3) : dot (V3.add u v) w = dot u w + dot v w := by
  unfold V3.add dot
  ring

lemma dual_cross_add_left (u v a : V3) :
    cross (V3.add u v) a = V3.add (cross u a) (cross v a) := by
  apply V3.ext <;> unfold cross V3.add <;> ring

lemma dual_cross_sub_left (u v a : V3) :
    cross (V3.sub u v) a = V3.sub (cross u a) (cross v a) := by
  apply V3.ext <;> unfold cross V3.sub <;> ring

lemma dual_cross_self (a : V3) : cross a a = ⟨0, 0, 0⟩ := by
  apply V3.ext <;> unfold cross <;> ring

lemma dual_pnSmul_ne_zero (s : ℝ) (v : V3) (hs : s ≠ 0) (hv : v ≠ ⟨0, 0, 0⟩) :
    pnSmul s v ≠ ⟨0, 0, 0⟩ := by
  intro h
  apply hv
  apply V3.ext
  · have hx := congrArg V3.x h
    dsimp [pnSmul] at hx
    exact (mul_eq_zero.mp hx).resolve_left hs
  · have hy := congrArg V3.y h
    dsimp [pnSmul] at hy
    exact (mul_eq_zero.mp hy).resolve_left hs
  · have hz := congrArg V3.z h
    dsimp [pnSmul] at hz
    exact (mul_eq_zero.mp hz).resolve_left hs

/-- If `cross v m = 0` and `m` is a unit vector, then `v` is the scalar multiple
    `(dot v m) • m`.  Derived from the Lagrange identity (no case split on the
    coordinates of `m`). -/
lemma dual_parallel_of_cross_zero (v m : V3) (hm : dot m m = 1)
    (hcross : cross v m = ⟨0, 0, 0⟩) :
    v = pnSmul (dot v m) m := by
  have hlag := dot_cross_cross v m m
  rw [hcross] at hlag
  have hzero : dot (⟨0, 0, 0⟩ : V3) ⟨0, 0, 0⟩ = 0 := by simp [dot]
  rw [hzero] at hlag
  rw [hm] at hlag
  have hsq : dot v v = (dot v m) ^ 2 := by nlinarith
  have hsqc : v.x * v.x + v.y * v.y + v.z * v.z =
      (v.x * m.x + v.y * m.y + v.z * m.z) ^ 2 := by
    simpa [dot] using hsq
  have hmc : m.x * m.x + m.y * m.y + m.z * m.z = 1 := by
    simpa [dot] using hm
  let w : V3 := V3.add v (pnSmul (-(dot v m)) m)
  have hwd : dot w w = 0 := by
    dsimp [w]
    unfold dot
    dsimp [pnSmul, V3.add]
    nlinarith
  have hw0 : w = ⟨0, 0, 0⟩ := by
    by_contra hne
    have hp := dot_pos_of_ne_zero w hne
    nlinarith
  apply V3.ext
  · have hx := congrArg V3.x hw0
    dsimp [w, V3.add, pnSmul] at hx ⊢
    nlinarith
  · have hy := congrArg V3.y hw0
    dsimp [w, V3.add, pnSmul] at hy ⊢
    nlinarith
  · have hz := congrArg V3.z hw0
    dsimp [w, V3.add, pnSmul] at hz ⊢
    nlinarith

/-- `v = m` if `v ∥ m`, `cross v u = cross m u`, and `cross m u ≠ 0`. -/
lemma dual_eq_of_parallel_and_cross (v m u : V3) (hm : dot m m = 1)
    (hpar : cross v m = ⟨0, 0, 0⟩)
    (hcmp : cross v u = cross m u)
    (hcu : cross m u ≠ ⟨0, 0, 0⟩) : v = m := by
  have ht := dual_parallel_of_cross_zero v m hm hpar
  have h : cross (pnSmul (dot v m) m) u = cross m u := by
    rw [← ht]
    exact hcmp
  rw [cross_pnSmul_left] at h
  have hd := congrArg (fun z => dot z (cross m u)) h
  rw [dot_pnSmul_left] at hd
  have hcp : 0 < dot (cross m u) (cross m u) := dot_pos_of_ne_zero _ hcu
  have hdoteq : dot v m = 1 := by nlinarith
  rw [ht, hdoteq, pnSmul_one]

/-! ### 1. The positive ray coefficients -/

noncomputable def dualC0 (n0 n1 n2 n3 : V3) : ℝ :=
  -(dot n0 (diagV21 n1 n2)) / (diagNW n0 n1 n2 n3 * norm (cross n3 n0))

noncomputable def dualC3 (n0 n1 n2 n3 : V3) : ℝ :=
  -(dot n3 (diagV21 n1 n2)) / (diagNW n0 n1 n2 n3 * norm (cross n3 n0))

noncomputable def dualC1 (n0 n1 n2 n3 : V3) : ℝ :=
  -(dot n1 (diagV10 n3 n0)) / (diagNW n0 n1 n2 n3 * norm (cross n1 n2))

noncomputable def dualC2 (n0 n1 n2 n3 : V3) : ℝ :=
  -(dot n2 (diagV10 n3 n0)) / (diagNW n0 n1 n2 n3 * norm (cross n1 n2))

/-! ### 2. `FanTriangleTransfer` helpers -/

lemma dual_transfer_a (a b m : V3) (wa wb d : ℝ) :
    FanTriangleTransfer ⟨a, b, m, wa, wb, d⟩ a := by
  unfold FanTriangleTransfer
  refine ⟨1, 0, 0, by norm_num, by norm_num, by norm_num,
    Or.inl (by norm_num), ?_⟩
  ring

lemma dual_transfer_b (a b m : V3) (wa wb d : ℝ) :
    FanTriangleTransfer ⟨a, b, m, wa, wb, d⟩ b := by
  unfold FanTriangleTransfer
  refine ⟨0, 1, 0, by norm_num, by norm_num, by norm_num,
    Or.inr (Or.inl (by norm_num)), ?_⟩
  ring

lemma dual_transfer_m (a b m : V3) (wa wb d : ℝ) :
    FanTriangleTransfer ⟨a, b, m, wa, wb, d⟩ m := by
  unfold FanTriangleTransfer
  refine ⟨0, 0, 1, by norm_num, by norm_num, by norm_num,
    Or.inr (Or.inr (by norm_num)), ?_⟩
  ring

/-- Transfer from an explicit nonnegative combination of the generators. -/
lemma dual_transfer_of_comb (a b m x : V3) (wa wb d l0 l1 lm : ℝ)
    (hl0 : 0 ≤ l0) (hl1 : 0 ≤ l1) (hlm : 0 ≤ lm)
    (hpos : 0 < l0 ∨ 0 < l1 ∨ 0 < lm)
    (hx : x = V3.add (V3.add (pnSmul l0 a) (pnSmul l1 b)) (pnSmul lm m)) :
    FanTriangleTransfer ⟨a, b, m, wa, wb, d⟩ x := by
  unfold FanTriangleTransfer
  refine ⟨l0, l1, lm, hl0, hl1, hlm, hpos, ?_⟩
  rw [hx]
  simp [dual_dot_add_left, dot_pnSmul_left]

/-! ### 3. Triangle nondegeneracy, unconditionally from the ray identities -/

lemma fourDiag_tri1_ne (n0 n1 n2 n3 : V3)
    (hw : cross (diagV10 n3 n0) (diagV21 n1 n2) ≠ ⟨0, 0, 0⟩)
    (h12 : cross n1 n2 ≠ ⟨0, 0, 0⟩)
    (hn0v21 : dot n0 (diagV21 n1 n2) < 0)
    (hn1v10 : dot n1 (diagV10 n3 n0) < 0) :
    triple n0 n1 (diagM n0 n1 n2 n3) ≠ 0 := by
  have hnwpos : 0 < diagNW n0 n1 n2 n3 := by
    dsimp [diagNW]
    exact norm_pos_of_ne_zero _ hw
  have hnbpos : 0 < norm (cross n1 n2) := norm_pos_of_ne_zero _ h12
  have hc1 : 0 < dualC1 n0 n1 n2 n3 := by
    dsimp [dualC1]
    exact div_pos (neg_pos.mpr hn1v10) (mul_pos hnwpos hnbpos)
  have hBscale : cross n1 n2 = pnSmul (norm (cross n1 n2)) (diagV21 n1 n2) := by
    unfold diagV21
    rw [pnSmul_pnSmul]
    have hn12 : norm (cross n1 n2) ≠ 0 := norm_ne_zero_of_ne_zero _ h12
    have hc : norm (cross n1 n2) * (1 / norm (cross n1 n2)) = 1 := by
      field_simp [hn12]
    rw [hc, pnSmul_one]
  have hlt : triple n0 n1 (diagM n0 n1 n2 n3) < 0 := by
    rw [← dot_cross_eq_triple]
    rw [diag_cross_n1_m]
    change dot n0 (pnSmul (dualC1 n0 n1 n2 n3) (cross n1 n2)) < 0
    rw [dot_pnSmul_right, hBscale, dot_pnSmul_right]
    exact mul_neg_of_pos_of_neg hc1 (mul_neg_of_pos_of_neg hnbpos hn0v21)
  exact ne_of_lt hlt

lemma fourDiag_tri2_ne (n0 n1 n2 n3 : V3)
    (hw : cross (diagV10 n3 n0) (diagV21 n1 n2) ≠ ⟨0, 0, 0⟩)
    (h30 : cross n3 n0 ≠ ⟨0, 0, 0⟩)
    (hn2v10 : dot n2 (diagV10 n3 n0) < 0)
    (hn3v21 : dot n3 (diagV21 n1 n2) < 0) :
    triple (pnSmul (-1) (diagM n0 n1 n2 n3)) n2 n3 ≠ 0 := by
  have hnwpos : 0 < diagNW n0 n1 n2 n3 := by
    dsimp [diagNW]
    exact norm_pos_of_ne_zero _ hw
  have hnapos : 0 < norm (cross n3 n0) := norm_pos_of_ne_zero _ h30
  have hc3 : 0 < dualC3 n0 n1 n2 n3 := by
    dsimp [dualC3]
    exact div_pos (neg_pos.mpr hn3v21) (mul_pos hnwpos hnapos)
  have hAscale : cross n3 n0 = pnSmul (norm (cross n3 n0)) (diagV10 n3 n0) := by
    unfold diagV10
    rw [pnSmul_pnSmul]
    have hn30 : norm (cross n3 n0) ≠ 0 := norm_ne_zero_of_ne_zero _ h30
    have hc : norm (cross n3 n0) * (1 / norm (cross n3 n0)) = 1 := by
      field_simp [hn30]
    rw [hc, pnSmul_one]
  have hn3m : cross n3 (diagM n0 n1 n2 n3) =
      pnSmul (-(dualC3 n0 n1 n2 n3)) (cross n3 n0) := by
    have h := congrArg (fun v => pnSmul (-1) v) (diag_neg_cross_n3 n0 n1 n2 n3)
    simpa [dualC3, pnSmul_pnSmul] using h
  have hlt : triple (pnSmul (-1) (diagM n0 n1 n2 n3)) n2 n3 < 0 := by
    rw [← dot_cross_eq_triple]
    -- dot (-m) (cross n2 n3) = dot n2 (cross n3 (-m))
    rw [show dot (pnSmul (-1) (diagM n0 n1 n2 n3)) (cross n2 n3) =
        dot n2 (cross n3 (pnSmul (-1) (diagM n0 n1 n2 n3))) by
          unfold dot cross
          ring]
    rw [cross_pnSmul_right, hn3m]
    rw [dot_pnSmul_right, dot_pnSmul_right]
    rw [hAscale, dot_pnSmul_right]
    have hprod : dualC3 n0 n1 n2 n3 *
        (norm (cross n3 n0) * dot n2 (diagV10 n3 n0)) < 0 :=
      mul_neg_of_pos_of_neg hc3 (mul_neg_of_pos_of_neg hnapos hn2v10)
    nlinarith [hprod]
  exact ne_of_lt hlt

/-! ### 4. The dual-cone containment -/

theorem fourDiag_dual_cone
    (n0 n1 n2 n3 : V3)
    (h30 : cross n3 n0 ≠ ⟨0, 0, 0⟩) (h12 : cross n1 n2 ≠ ⟨0, 0, 0⟩)
    (hw : cross (diagV10 n3 n0) (diagV21 n1 n2) ≠ ⟨0, 0, 0⟩)
    (hn0v21 : dot n0 (diagV21 n1 n2) < 0)
    (hn1v10 : dot n1 (diagV10 n3 n0) < 0)
    (hn2v10 : dot n2 (diagV10 n3 n0) < 0)
    (hn3v21 : dot n3 (diagV21 n1 n2) < 0) :
    (∀ j : Fin 4, FanTriangleTransfer ⟨n0, n1, diagM n0 n1 n2 n3,
        quadTheta0 n0 n1 n3, quadTheta1 n0 n1 n2,
        quadDiag n3 n0 n1 n2⟩ (fanFace4 n0 n1 n2 n3 j)) ∧
    (∀ j : Fin 4, FanTriangleTransfer ⟨pnSmul (-1) (diagM n0 n1 n2 n3),
        n2, n3, quadDiag n3 n0 n1 n2,
        quadTheta2 n1 n2 n3, quadTheta3 n2 n3 n0⟩
        (fanFace4 n0 n1 n2 n3 j)) := by
  have hnwpos : 0 < diagNW n0 n1 n2 n3 := by
    dsimp [diagNW]
    exact norm_pos_of_ne_zero _ hw
  have hnapos : 0 < norm (cross n3 n0) := norm_pos_of_ne_zero _ h30
  have hnbpos : 0 < norm (cross n1 n2) := norm_pos_of_ne_zero _ h12
  have hc0 : 0 < dualC0 n0 n1 n2 n3 := by
    dsimp [dualC0]
    exact div_pos (neg_pos.mpr hn0v21) (mul_pos hnwpos hnapos)
  have hc3 : 0 < dualC3 n0 n1 n2 n3 := by
    dsimp [dualC3]
    exact div_pos (neg_pos.mpr hn3v21) (mul_pos hnwpos hnapos)
  have hc1 : 0 < dualC1 n0 n1 n2 n3 := by
    dsimp [dualC1]
    exact div_pos (neg_pos.mpr hn1v10) (mul_pos hnwpos hnbpos)
  have hc2 : 0 < dualC2 n0 n1 n2 n3 := by
    dsimp [dualC2]
    exact div_pos (neg_pos.mpr hn2v10) (mul_pos hnwpos hnbpos)
  have hm_unit : dot (diagM n0 n1 n2 n3) (diagM n0 n1 n2 n3) = 1 :=
    diagM_unit n0 n1 n2 n3 hw
  have hn0m : cross n0 (diagM n0 n1 n2 n3) =
      pnSmul (-(dualC0 n0 n1 n2 n3)) (cross n3 n0) := by
    have h := congrArg (fun v => pnSmul (-1) v) (diag_neg_cross_n0 n0 n1 n2 n3)
    simpa [dualC0, pnSmul_pnSmul] using h
  have hn3m : cross n3 (diagM n0 n1 n2 n3) =
      pnSmul (-(dualC3 n0 n1 n2 n3)) (cross n3 n0) := by
    have h := congrArg (fun v => pnSmul (-1) v) (diag_neg_cross_n3 n0 n1 n2 n3)
    simpa [dualC3, pnSmul_pnSmul] using h
  have hn1m : cross n1 (diagM n0 n1 n2 n3) =
      pnSmul (dualC1 n0 n1 n2 n3) (cross n1 n2) := by
    simpa [dualC1] using (diag_cross_n1_m n0 n1 n2 n3)
  have hn2m : cross n2 (diagM n0 n1 n2 n3) =
      pnSmul (dualC2 n0 n1 n2 n3) (cross n1 n2) := by
    simpa [dualC2] using (diag_cross_n2_m n0 n1 n2 n3)

  -- The identity c1·n2 - c2·n1 = m.
  have hI2v : V3.sub (pnSmul (dualC1 n0 n1 n2 n3) n2)
      (pnSmul (dualC2 n0 n1 n2 n3) n1) = diagM n0 n1 n2 n3 := by
    apply dual_eq_of_parallel_and_cross
      (V3.sub (pnSmul (dualC1 n0 n1 n2 n3) n2)
        (pnSmul (dualC2 n0 n1 n2 n3) n1))
      (diagM n0 n1 n2 n3) n1 hm_unit
    · rw [dual_cross_sub_left, cross_pnSmul_left, cross_pnSmul_left, hn2m, hn1m]
      apply V3.ext <;> dsimp [V3.sub, pnSmul] <;> ring
    · rw [dual_cross_sub_left, cross_pnSmul_left, cross_pnSmul_left]
      rw [show cross n2 n1 = pnSmul (-1 : ℝ) (cross n1 n2) by
        simpa using (diag_cross_swap n2 n1)]
      rw [dual_cross_self]
      rw [diag_cross_swap (diagM n0 n1 n2 n3) n1, hn1m]
      apply V3.ext <;> dsimp [V3.sub, pnSmul] <;> ring
    · rw [diag_cross_swap (diagM n0 n1 n2 n3) n1, hn1m]
      exact dual_pnSmul_ne_zero (-1 : ℝ)
        (pnSmul (dualC1 n0 n1 n2 n3) (cross n1 n2)) (by norm_num)
        (dual_pnSmul_ne_zero (dualC1 n0 n1 n2 n3) (cross n1 n2) (ne_of_gt hc1) h12)
  have hI2 : pnSmul (dualC1 n0 n1 n2 n3) n2 =
      V3.add (pnSmul (dualC2 n0 n1 n2 n3) n1) (diagM n0 n1 n2 n3) := by
    apply V3.ext
    · have hx := congrArg V3.x hI2v
      dsimp [V3.sub] at hx
      dsimp [V3.add]
      linarith
    · have hy := congrArg V3.y hI2v
      dsimp [V3.sub] at hy
      dsimp [V3.add]
      linarith
    · have hz := congrArg V3.z hI2v
      dsimp [V3.sub] at hz
      dsimp [V3.add]
      linarith

  -- The identity c0·n3 - c3·n0 = m.
  have hI3v : V3.sub (pnSmul (dualC0 n0 n1 n2 n3) n3)
      (pnSmul (dualC3 n0 n1 n2 n3) n0) = diagM n0 n1 n2 n3 := by
    apply dual_eq_of_parallel_and_cross
      (V3.sub (pnSmul (dualC0 n0 n1 n2 n3) n3)
        (pnSmul (dualC3 n0 n1 n2 n3) n0))
      (diagM n0 n1 n2 n3) n0 hm_unit
    · rw [dual_cross_sub_left, cross_pnSmul_left, cross_pnSmul_left, hn3m, hn0m]
      apply V3.ext <;> dsimp [V3.sub, pnSmul] <;> ring
    · rw [dual_cross_sub_left, cross_pnSmul_left, cross_pnSmul_left]
      rw [dual_cross_self]
      rw [diag_cross_swap (diagM n0 n1 n2 n3) n0, hn0m]
      apply V3.ext <;> dsimp [V3.sub, pnSmul] <;> ring
    · rw [diag_cross_swap (diagM n0 n1 n2 n3) n0, hn0m]
      exact dual_pnSmul_ne_zero (-1 : ℝ)
        (pnSmul (-(dualC0 n0 n1 n2 n3)) (cross n3 n0)) (by norm_num)
        (dual_pnSmul_ne_zero (-(dualC0 n0 n1 n2 n3)) (cross n3 n0)
          (neg_ne_zero.mpr (ne_of_gt hc0)) h30)
  have hI3 : pnSmul (dualC0 n0 n1 n2 n3) n3 =
      V3.add (pnSmul (dualC3 n0 n1 n2 n3) n0) (diagM n0 n1 n2 n3) := by
    apply V3.ext
    · have hx := congrArg V3.x hI3v
      dsimp [V3.sub] at hx
      dsimp [V3.add]
      linarith
    · have hy := congrArg V3.y hI3v
      dsimp [V3.sub] at hy
      dsimp [V3.add]
      linarith
    · have hz := congrArg V3.z hI3v
      dsimp [V3.sub] at hz
      dsimp [V3.add]
      linarith

  -- The four rearranged combination identities.
  have hcomb_n2 : n2 = V3.add
      (V3.add (pnSmul 0 n0)
        (pnSmul ((dualC2 n0 n1 n2 n3) / (dualC1 n0 n1 n2 n3)) n1))
      (pnSmul (1 / (dualC1 n0 n1 n2 n3)) (diagM n0 n1 n2 n3)) := by
    apply V3.ext
    · have hx := congrArg V3.x hI2
      dsimp [pnSmul, V3.add] at hx ⊢
      field_simp [ne_of_gt hc1]
      nlinarith
    · have hy := congrArg V3.y hI2
      dsimp [pnSmul, V3.add] at hy ⊢
      field_simp [ne_of_gt hc1]
      nlinarith
    · have hz := congrArg V3.z hI2
      dsimp [pnSmul, V3.add] at hz ⊢
      field_simp [ne_of_gt hc1]
      nlinarith
  have hcomb_n3 : n3 = V3.add
      (V3.add
        (pnSmul ((dualC3 n0 n1 n2 n3) / (dualC0 n0 n1 n2 n3)) n0)
        (pnSmul 0 n1))
      (pnSmul (1 / (dualC0 n0 n1 n2 n3)) (diagM n0 n1 n2 n3)) := by
    apply V3.ext
    · have hx := congrArg V3.x hI3
      dsimp [pnSmul, V3.add] at hx ⊢
      field_simp [ne_of_gt hc0]
      nlinarith
    · have hy := congrArg V3.y hI3
      dsimp [pnSmul, V3.add] at hy ⊢
      field_simp [ne_of_gt hc0]
      nlinarith
    · have hz := congrArg V3.z hI3
      dsimp [pnSmul, V3.add] at hz ⊢
      field_simp [ne_of_gt hc0]
      nlinarith
  have hcomb_n0 : n0 = V3.add
      (V3.add
        (pnSmul (1 / (dualC3 n0 n1 n2 n3)) (pnSmul (-1) (diagM n0 n1 n2 n3)))
        (pnSmul 0 n2))
      (pnSmul ((dualC0 n0 n1 n2 n3) / (dualC3 n0 n1 n2 n3)) n3) := by
    apply V3.ext
    · have hx := congrArg V3.x hI3
      dsimp [pnSmul, V3.add] at hx ⊢
      field_simp [ne_of_gt hc3]
      nlinarith
    · have hy := congrArg V3.y hI3
      dsimp [pnSmul, V3.add] at hy ⊢
      field_simp [ne_of_gt hc3]
      nlinarith
    · have hz := congrArg V3.z hI3
      dsimp [pnSmul, V3.add] at hz ⊢
      field_simp [ne_of_gt hc3]
      nlinarith
  have hcomb_n1 : n1 = V3.add
      (V3.add
        (pnSmul (1 / (dualC2 n0 n1 n2 n3)) (pnSmul (-1) (diagM n0 n1 n2 n3)))
        (pnSmul ((dualC1 n0 n1 n2 n3) / (dualC2 n0 n1 n2 n3)) n2))
      (pnSmul 0 n3) := by
    apply V3.ext
    · have hx := congrArg V3.x hI2
      dsimp [pnSmul, V3.add] at hx ⊢
      field_simp [ne_of_gt hc2]
      nlinarith
    · have hy := congrArg V3.y hI2
      dsimp [pnSmul, V3.add] at hy ⊢
      field_simp [ne_of_gt hc2]
      nlinarith
    · have hz := congrArg V3.z hI2
      dsimp [pnSmul, V3.add] at hz ⊢
      field_simp [ne_of_gt hc2]
      nlinarith

  constructor
  · intro j
    fin_cases j <;> dsimp [fanFace4]
    · exact dual_transfer_a n0 n1 (diagM n0 n1 n2 n3)
        (quadTheta0 n0 n1 n3) (quadTheta1 n0 n1 n2) (quadDiag n3 n0 n1 n2)
    · exact dual_transfer_b n0 n1 (diagM n0 n1 n2 n3)
        (quadTheta0 n0 n1 n3) (quadTheta1 n0 n1 n2) (quadDiag n3 n0 n1 n2)
    · exact dual_transfer_of_comb n0 n1 (diagM n0 n1 n2 n3) n2
        (quadTheta0 n0 n1 n3) (quadTheta1 n0 n1 n2) (quadDiag n3 n0 n1 n2)
        0 ((dualC2 n0 n1 n2 n3) / (dualC1 n0 n1 n2 n3))
        (1 / (dualC1 n0 n1 n2 n3))
        (le_refl 0)
        (div_nonneg (le_of_lt hc2) (le_of_lt hc1))
        (div_nonneg zero_le_one (le_of_lt hc1))
        (Or.inr (Or.inl (div_pos hc2 hc1)))
        hcomb_n2
    · exact dual_transfer_of_comb n0 n1 (diagM n0 n1 n2 n3) n3
        (quadTheta0 n0 n1 n3) (quadTheta1 n0 n1 n2) (quadDiag n3 n0 n1 n2)
        ((dualC3 n0 n1 n2 n3) / (dualC0 n0 n1 n2 n3)) 0
        (1 / (dualC0 n0 n1 n2 n3))
        (div_nonneg (le_of_lt hc3) (le_of_lt hc0))
        (le_refl 0)
        (div_nonneg zero_le_one (le_of_lt hc0))
        (Or.inl (div_pos hc3 hc0))
        hcomb_n3
  · intro j
    fin_cases j <;> dsimp [fanFace4]
    · exact dual_transfer_of_comb (pnSmul (-1) (diagM n0 n1 n2 n3)) n2 n3 n0
        (quadDiag n3 n0 n1 n2) (quadTheta2 n1 n2 n3) (quadTheta3 n2 n3 n0)
        (1 / (dualC3 n0 n1 n2 n3)) 0
        ((dualC0 n0 n1 n2 n3) / (dualC3 n0 n1 n2 n3))
        (div_nonneg zero_le_one (le_of_lt hc3))
        (le_refl 0)
        (div_nonneg (le_of_lt hc0) (le_of_lt hc3))
        (Or.inl (div_pos zero_lt_one hc3))
        hcomb_n0
    · exact dual_transfer_of_comb (pnSmul (-1) (diagM n0 n1 n2 n3)) n2 n3 n1
        (quadDiag n3 n0 n1 n2) (quadTheta2 n1 n2 n3) (quadTheta3 n2 n3 n0)
        (1 / (dualC2 n0 n1 n2 n3))
        ((dualC1 n0 n1 n2 n3) / (dualC2 n0 n1 n2 n3)) 0
        (div_nonneg zero_le_one (le_of_lt hc2))
        (div_nonneg (le_of_lt hc1) (le_of_lt hc2))
        (le_refl 0)
        (Or.inl (div_pos zero_lt_one hc2))
        hcomb_n1
    · exact dual_transfer_b (pnSmul (-1) (diagM n0 n1 n2 n3)) n2 n3
        (quadDiag n3 n0 n1 n2) (quadTheta2 n1 n2 n3) (quadTheta3 n2 n3 n0)
    · exact dual_transfer_m (pnSmul (-1) (diagM n0 n1 n2 n3)) n2 n3
        (quadDiag n3 n0 n1 n2) (quadTheta2 n1 n2 n3) (quadTheta3 n2 n3 n0)

/-! ### 5. Unconditional n = 4 seam -/

/-- `fourDiag_face_pos_of_convex` with its dual-cone and nondegeneracy hypotheses
    discharged by the explicit diagonal construction. -/
theorem fourDiag_face_pos_unconditional
    (n0 n1 n2 n3 : V3)
    (h0 : dot n0 n0 = 1) (h1 : dot n1 n1 = 1)
    (h2 : dot n2 n2 = 1) (h3 : dot n3 n3 = 1)
    (h01 : cross n0 n1 ≠ ⟨0, 0, 0⟩) (h30 : cross n3 n0 ≠ ⟨0, 0, 0⟩)
    (h12 : cross n1 n2 ≠ ⟨0, 0, 0⟩) (h23 : cross n2 n3 ≠ ⟨0, 0, 0⟩)
    (hw : cross (diagV10 n3 n0) (diagV21 n1 n2) ≠ ⟨0, 0, 0⟩)
    (hn0v21 : dot n0 (diagV21 n1 n2) < 0)
    (hn1v10 : dot n1 (diagV10 n3 n0) < 0)
    (hn2v10 : dot n2 (diagV10 n3 n0) < 0)
    (hn3v21 : dot n3 (diagV21 n1 n2) < 0) :
    ∀ j : Fin 4,
      0 < ∑ i : Fin 4, fourTheta
        (quadTheta0 n0 n1 n3) (quadTheta1 n0 n1 n2)
        (quadTheta2 n1 n2 n3) (quadTheta3 n2 n3 n0) i *
        dot (fanFace4 n0 n1 n2 n3 i) (fanFace4 n0 n1 n2 n3 j) := by
  have hdual := fourDiag_dual_cone n0 n1 n2 n3 h30 h12 hw
    hn0v21 hn1v10 hn2v10 hn3v21
  exact fourDiag_face_pos_of_convex n0 n1 n2 n3 h0 h1 h2 h3
    h01 h30 h12 h23 hw hn0v21 hn1v10 hn2v10 hn3v21
    (fourDiag_tri1_ne n0 n1 n2 n3 hw h12 hn0v21 hn1v10)
    (fourDiag_tri2_ne n0 n1 n2 n3 hw h30 hn2v10 hn3v21)
    hdual.1 hdual.2

end V3
end Vdb
