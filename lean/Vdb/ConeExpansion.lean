/-
  TinyVDB - Lean 4 formalization of the OpenVDB (`.vdb`) file format
  and the volume operators.

  The **closest-point cone expansion** for finite half-space intersections
  — the bipolar / Farkas content behind the mesh→SDF closest-feature
  sign rule (finding F16, `lean/VERIFICATION.md`), which the landed
  `Vdb/NormalCone.lean` deliberately did not model:

  * `N_K(q)` (the normal cone at `q`) contains every nonneg combination of
    the tight face normals (`tight_cone_subset_normal`) — the easy half;
  * **`farkas_closure`** — the reverse: the projection inequality
    `⟪p − q, v − q⟫ ≤ 0` for every `v ∈ K` forces `p − q` into the
    **closure** of the cone generated by the tight face normals. This is
    the Farkas / geometric-Hahn–Banach step: a separating functional of
    `p − q` from that closed cone pairs non-negatively with every tight
    normal (else a large multiple of it would violate separation), hence
    `−g` (its Riesz vector) is a feasible direction into `K`, contradicting
    the assumption — this is the standard Farkas argument, formalized
    against `geometric_hahn_banach_point_closed`;
  * **`farkas_closest_direction`** — the application: for a closest point
    `q` of the half-space intersection `K` to an outside point `p`
    (Hilbert projection), `p − q` lies in that closed cone — the rigorous
    content of "the closest-point direction is a nonneg combination of
    the incident face normals", up to taking the closure.

  What is **not** claimed: `p − q = Σ λᵢ nᵢ` exactly (λᵢ ≥ 0). That needs
  the closed cone to equal the finitely generated cone, i.e. that
  finitely generated cones are closed (or the pointed-cone closure theorem,
  or Carathéodory); none of that is in the scope (or in mathlib, as far
  as we checked). The closure statement is the honest Farkas content —
  it implies everything the sign test needs at the model level. The
  angle-weighted Bærentzen–Aanæs pseudo-normals (weights from face corner
  angles) remain unmodelled.

  Copyright (c) 2026 Syoyo Fujita and TinyVDB authors
  SPDX-License-Identifier: Apache-2.0
-/
import Vdb.NormalCone
import Mathlib.Analysis.LocallyConvex.Separation
import Mathlib.Analysis.InnerProductSpace.Dual

set_option linter.unusedSimpArgs false
set_option linter.unusedSectionVars false

namespace Vdb

open Classical
open scoped RealInnerProductSpace

variable {ι : Type*} [Fintype ι] [DecidableEq ι] {F : Type*}
  [NormedAddCommGroup F] [InnerProductSpace ℝ F] [FiniteDimensional ℝ F]

/-! ### The (finitely generated) cone -/

/-- The cone generated by a family of vectors: finite nonneg combinations. -/
def coneGen (v : ι → F) : Set F :=
  {y | ∃ ℓ : ι → ℝ, (∀ i, 0 ≤ ℓ i) ∧ y = ∑ i, ℓ i • v i}

theorem mem_coneGen {v : ι → F} {y : F} :
    y ∈ coneGen v ↔ ∃ ℓ : ι → ℝ, (∀ i, 0 ≤ ℓ i) ∧ y = ∑ i, ℓ i • v i := Iff.rfl

theorem zero_mem_coneGen (v : ι → F) : (0 : F) ∈ coneGen v :=
  ⟨0, fun _ => le_rfl, by simp⟩

theorem smul_mem_coneGen {v : ι → F} {y : F} {c : ℝ} (hc : 0 ≤ c) (hy : y ∈ coneGen v) :
    c • y ∈ coneGen v := by
  obtain ⟨ℓ, hℓ0, rfl⟩ := hy
  refine ⟨fun i => c * ℓ i, fun i => mul_nonneg hc (hℓ0 i), ?_⟩
  rw [Finset.smul_sum]
  apply Finset.sum_congr rfl
  intro i _
  dsimp only
  rw [smul_smul, mul_comm c (ℓ i)]

theorem add_mem_coneGen {v : ι → F} {y z : F} (hy : y ∈ coneGen v) (hz : z ∈ coneGen v) :
    y + z ∈ coneGen v := by
  obtain ⟨ℓ, hℓ0, rfl⟩ := hy
  obtain ⟨μ, hμ0, rfl⟩ := hz
  refine ⟨fun i => ℓ i + μ i, fun i => add_nonneg (hℓ0 i) (hμ0 i), ?_⟩
  rw [← Finset.sum_add_distrib]
  apply Finset.sum_congr rfl
  intro i _
  rw [add_smul]

theorem convex_coneGen (v : ι → F) : Convex ℝ (coneGen v) := by
  intro x hx y hy a c ha hc hac
  obtain ⟨ℓ, hℓ0, rfl⟩ := hx
  obtain ⟨μ, hμ0, rfl⟩ := hy
  refine ⟨fun i => a * ℓ i + c * μ i,
    fun i => add_nonneg (mul_nonneg ha (hℓ0 i)) (mul_nonneg hc (hμ0 i)), ?_⟩
  rw [Finset.smul_sum, Finset.smul_sum, ← Finset.sum_add_distrib]
  apply Finset.sum_congr rfl
  intro i _
  dsimp only
  rw [smul_smul, smul_smul, ← add_smul]

/-- The closed cone generated by the tight face normals at `q`. -/
def closedTightCone {ι : Type*} [Fintype ι] [DecidableEq ι] {F : Type*}
    [NormedAddCommGroup F] [InnerProductSpace ℝ F] [FiniteDimensional ℝ F]
    (n : ι → F) (b : ι → ℝ) (q : F) : Set F :=
  closure (coneGen fun i => if Tight n b q i then n i else 0)

theorem isClosed_closedTightCone {ι : Type*} [Fintype ι] [DecidableEq ι]
    {F : Type*} [NormedAddCommGroup F] [InnerProductSpace ℝ F] [FiniteDimensional ℝ F]
    (n : ι → F) (b : ι → ℝ) (q : F) :
    IsClosed (closedTightCone n b q) := isClosed_closure

theorem convex_closedTightCone {ι : Type*} [Fintype ι] [DecidableEq ι]
    {F : Type*} [NormedAddCommGroup F] [InnerProductSpace ℝ F] [FiniteDimensional ℝ F]
    (n : ι → F) (b : ι → ℝ) (q : F) :
    Convex ℝ (closedTightCone n b q) :=
  (convex_coneGen _).closure

theorem zero_mem_closedTightCone {ι : Type*} [Fintype ι] [DecidableEq ι]
    {F : Type*} [NormedAddCommGroup F] [InnerProductSpace ℝ F] [FiniteDimensional ℝ F]
    (n : ι → F) (b : ι → ℝ) (q : F) :
    (0 : F) ∈ closedTightCone n b q :=
  subset_closure (zero_mem_coneGen _)

theorem coneGen_tight_mem {n : ι → F} {b : ι → ℝ} {q : F}
    (i : ι) (hi : Tight n b q i) :
    n i ∈ coneGen fun j => if Tight n b q j then n j else 0 :=
  ⟨fun j => if j = i then (1 : ℝ) else 0,
    fun j => by by_cases hj : j = i <;> simp [hj, zero_le_one],
    by
      rw [Finset.sum_eq_single i]
      · simp [hi]
      · intro j _ hj
        simp [hj]
      · exact fun hj => absurd (Finset.mem_univ i) hj⟩

theorem tight_cone_subset_closure {n : ι → F} {b : ι → ℝ} {q : F} :
    coneGen (fun i => if Tight n b q i then n i else 0) ⊆ closedTightCone n b q :=
  subset_closure

/-! ### The easy inclusion: the generated cone is in the normal cone -/

/-- Every finite nonneg combination of tight normals pairs non-positively
    with `v − q` for `v ∈ K`. -/
theorem tight_cone_subset_normal {ι : Type*} [Fintype ι] [DecidableEq ι]
    {F : Type*} [NormedAddCommGroup F] [InnerProductSpace ℝ F]
    {n : ι → F} {b : ι → ℝ} {q v : F}
    (hv : v ∈ halfSpaces n b) (_hq : q ∈ halfSpaces n b) :
    ∀ y ∈ coneGen (fun i => if Tight n b q i then n i else 0),
      ⟪y, v - q⟫ ≤ 0 := by
  have key : ∀ (s : Finset ι) (ℓ : ι → ℝ),
      (∀ i, 0 ≤ ℓ i) →
      ⟪∑ i ∈ s, ℓ i • (if Tight n b q i then n i else 0), v - q⟫ ≤ 0 := by
    intro s ℓ hℓ
    induction s using Finset.induction with
    | empty => simp
    | insert a s has ih =>
      rw [Finset.sum_insert has, inner_add_left]
      have ha : ⟪ℓ a • (if Tight n b q a then n a else 0), v - q⟫ ≤ 0 := by
        by_cases hi : Tight n b q a
        · simp only [hi, ite_true, real_inner_smul_left]
          have h1 : ⟪n a, v⟫ ≤ b a := hv a
          have h2 : ⟪n a, q⟫ = b a := hi
          have h3 : ⟪n a, v - q⟫ = ⟪n a, v⟫ - ⟪n a, q⟫ := by rw [inner_sub_right]
          have hnn : 0 ≤ ℓ a := hℓ a
          rw [h3, h2]
          nlinarith
        · simp [hi, ite_false, real_inner_smul_left]
      have ih' := ih
      nlinarith
  intro y hy
  obtain ⟨ℓ, hℓ0, rfl⟩ := hy
  exact key Finset.univ ℓ hℓ0

/-! ### The Farkas step: the projection inequality forces closure membership -/

/-- **Conic Farkas (closure form)**: if `p − q` pairs non-positively with
    every point of the half-space intersection `K` at the closest point
    `q`, then `p − q` lies in the closure of the cone generated by the
    tight face normals at `q`. The separation functional of `p − q` from
    that closed cone pairs non-negatively with every tight normal (a large
    multiple of any negative-pairing tight normal would violate the
    separation), hence its Riesz vector `g` gives the feasible direction
    `q − t • g ∈ K` for small `t > 0`, contradicting `⟪p − q, ·⟫ ≤ 0`. -/
theorem farkas_closure {ι : Type*} [Fintype ι] [DecidableEq ι] {F : Type*}
    [NormedAddCommGroup F] [InnerProductSpace ℝ F] [FiniteDimensional ℝ F]
    {n : ι → F} {b : ι → ℝ} {p q : F}
    (hq : q ∈ halfSpaces n b)
    (hp : ∀ v ∈ halfSpaces n b, ⟪p - q, v - q⟫ ≤ 0) :
    p - q ∈ closedTightCone n b q := by
  by_contra hnot
  obtain ⟨f, u, hfu, hfc⟩ := geometric_hahn_banach_point_closed
    (convex_closedTightCone (n := n) (b := b) (q := q))
    (isClosed_closedTightCone (n := n) (b := b) (q := q)) hnot
  have h0 : u < 0 := by
    have := hfc 0 (zero_mem_closedTightCone (n := n) (b := b) (q := q))
    simpa using this
  /- `f` pairs non-negatively with every tight normal. -/
  have hf_nonneg : ∀ i, Tight n b q i → 0 ≤ f (n i) := by
    intro i hi
    by_contra hcon
    have hne : f (n i) < 0 := lt_of_not_ge hcon
    have hpos : 0 < u / f (n i) := by
      rw [div_pos_iff]
      exact Or.inr ⟨h0, hne⟩
    have hmem : (u / f (n i)) • n i ∈ coneGen fun j => if Tight n b q j then n j else 0 := by
      refine ⟨fun j => if j = i then u / f (n i) else 0, ?_, ?_⟩
      · intro j
        dsimp only
        split_ifs with hj
        · subst hj; exact hpos.le
        · exact le_rfl
      · rw [Finset.sum_eq_single i]
        · simp [hi]
        · intro j _ hj
          simp [hj]
        · exact fun hj => absurd (Finset.mem_univ i) hj
    have hle := hfc _ (subset_closure hmem)
    have heq : f ((u / f (n i)) • n i) = u := by
      rw [map_smul, smul_eq_mul]
      exact div_mul_cancel₀ _ (ne_of_lt hne)
    rw [heq] at hle
    exact absurd hle (lt_irrefl u)
  /- The Riesz vector of the functional. -/
  set g : F := (InnerProductSpace.toDual ℝ F).symm f with hg
  have hgfun : ∀ y : F, f y = ⟪g, y⟫ := fun y => (InnerProductSpace.toDual_symm_apply (x := y)).symm
  /- A small feasible step from `q` in direction `-g` stays in `K`. -/
  let T : Finset ι := Finset.univ.filter fun i => ¬ ⟪n i, q⟫ = b i
  let ratio : ι → ℝ := fun i => (b i - ⟪n i, q⟫) / (|f (n i)| + 1)
  by_cases hT : T.Nonempty
  · have hpos : ∀ i ∈ T, 0 < (b i - ⟪n i, q⟫) / (|f (n i)| + 1) := by
      intro i hi
      have hle : ⟪n i, q⟫ ≤ b i := hq i
      have hne : ⟪n i, q⟫ ≠ b i := (Finset.mem_filter.mp hi).2
      have h1 : ⟪n i, q⟫ < b i := lt_of_le_of_ne hle hne
      have h2 : 0 < |f (n i)| + 1 := by
        have := abs_nonneg (f (n i))
        nlinarith
      exact div_pos (by linarith) h2
    let t := (T.image ratio).min' (hT.image ratio)
    have ht : 0 < t := by
      have hmem : t ∈ T.image ratio := Finset.min'_mem _ _
      obtain ⟨i, hiT, hi_eq⟩ := Finset.mem_image.mp hmem
      rw [show t = ratio i from hi_eq.symm]
      exact hpos i hiT
    have hTsmall : ∀ i ∈ T, t * (|f (n i)| + 1) ≤ b i - ⟪n i, q⟫ := by
      intro i hi
      have hmem : ratio i ∈ T.image ratio := Finset.mem_image.mpr ⟨i, hi, rfl⟩
      have hle := Finset.min'_le _ _ hmem
      have hpos' : 0 < |f (n i)| + 1 := by
        have := abs_nonneg (f (n i))
        nlinarith
      rw [show t = (T.image ratio).min' (hT.image ratio) from rfl]
      rw [le_div_iff₀ hpos'] at hle
      nlinarith [hle]
    have hv : q - t • g ∈ halfSpaces n b := by
      intro i
      by_cases htight : ⟪n i, q⟫ = b i
      · have hgn : ⟪n i, g⟫ = f (n i) := by
          rw [real_inner_comm]
          exact (hgfun (n i)).symm
        calc ⟪n i, q - t • g⟫
            = ⟪n i, q⟫ - t * ⟪n i, g⟫ := by
              rw [inner_sub_right, real_inner_smul_right]
          _ = ⟪n i, q⟫ - t * f (n i) := by rw [hgn]
          _ = b i - t * f (n i) := by rw [htight]
          _ ≤ b i := by
              have hfn : 0 ≤ f (n i) := hf_nonneg i htight
              have ht0 : 0 ≤ t := le_of_lt ht
              nlinarith
      · have hiT : i ∈ T := Finset.mem_filter.mpr ⟨Finset.mem_univ _, htight⟩
        have hle : ⟪n i, q⟫ ≤ b i := hq i
        have hsl := hTsmall i hiT
        have hy_abs : -f (n i) ≤ |f (n i)| := by rw [← abs_neg]; exact le_abs_self _
        have hgn : ⟪n i, g⟫ = f (n i) := by
          rw [real_inner_comm]
          exact (hgfun (n i)).symm
        calc ⟪n i, q - t • g⟫
              = ⟪n i, q⟫ - t * ⟪n i, g⟫ := by
                rw [inner_sub_right, real_inner_smul_right]
            _ = ⟪n i, q⟫ - t * f (n i) := by rw [hgn]
            _ ≤ ⟪n i, q⟫ + t * |f (n i)| := by nlinarith [hy_abs]
            _ ≤ ⟪n i, q⟫ + t * (|f (n i)| + 1) := by
                have ht0 : 0 ≤ t := le_of_lt ht
                nlinarith
            _ ≤ ⟪n i, q⟫ + (b i - ⟪n i, q⟫) := by nlinarith
            _ = b i := by ring
    have hcon := hp (q - t • g) hv
    have e2 : (q - t • g) - q = -(t • g) := by module
    have hpc : ⟪p - q, g⟫ = f (p - q) := by
      rw [real_inner_comm]
      exact (hgfun (p - q)).symm
    have e1 : ⟪p - q, (q - t • g) - q⟫ = -t * f (p - q) := by
      rw [e2, inner_neg_right, real_inner_smul_right, hpc]
      ring
    rw [e1] at hcon
    have hfy : f (p - q) < 0 := lt_trans hfu h0
    nlinarith [hcon, ht, hfy]
  · /- All constraints are tight at `q`. -/
    have hv : q - (1 : ℝ) • g ∈ halfSpaces n b := by
      intro i
      have htight : ⟪n i, q⟫ = b i := by
        by_contra hne
        have hiT : i ∈ T := Finset.mem_filter.mpr ⟨Finset.mem_univ _, hne⟩
        exact hT ⟨i, hiT⟩
      have hgn : ⟪n i, g⟫ = f (n i) := by
        rw [real_inner_comm]
        exact (hgfun (n i)).symm
      calc ⟪n i, q - (1 : ℝ) • g⟫
            = ⟪n i, q⟫ - ⟪n i, g⟫ := by
              rw [inner_sub_right, one_smul]
        _ = b i - f (n i) := by rw [hgn, htight]
        _ ≤ b i := by
            have hfn : 0 ≤ f (n i) := hf_nonneg i htight
            nlinarith
    have hcon := hp (q - (1 : ℝ) • g) hv
    have e2 : (q - (1 : ℝ) • g) - q = -g := by module
    have hpc : ⟪p - q, g⟫ = f (p - q) := by
      rw [real_inner_comm]
      exact (hgfun (p - q)).symm
    have e1 : ⟪p - q, (q - (1 : ℝ) • g) - q⟫ = -f (p - q) := by
      rw [e2, inner_neg_right, hpc]
    rw [e1] at hcon
    have hfy : f (p - q) < 0 := lt_trans hfu h0
    nlinarith [hcon, hfy]

/-- **Closest-point application**: for a closest point `q ∈ K` to `p`
    (Hilbert projection onto the nonempty closed convex half-space
    intersection), the direction `p − q` lies in the closed cone generated
    by the tight face normals at `q`. This is the Farkas/bipolar content of
    the closest-point cone expansion `p − q = Σ λᵢ nᵢ` (λᵢ ≥ 0) — the exact
    expansion needs the closed cone to equal the finitely generated one,
    which is not proved (see the module doc). -/
theorem farkas_closest_direction {ι : Type*} [Fintype ι] [DecidableEq ι] {F : Type*}
    [NormedAddCommGroup F] [InnerProductSpace ℝ F] [FiniteDimensional ℝ F]
    {n : ι → F} {b : ι → ℝ} {p q : F}
    (hq : q ∈ halfSpaces n b)
    (hm : ‖p - q‖ = ⨅ w : (halfSpaces n b), ‖p - w‖) :
    p - q ∈ closedTightCone n b q := by
  apply farkas_closure hq
  intro v hv
  exact (norm_eq_iInf_iff_real_inner_le_zero (convex_halfSpaces (n := n) (b := b)) hq).mp hm v hv

end Vdb
