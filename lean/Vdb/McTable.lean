/-! ### The grid structure -/

/-- Edge between corner `a` and corner `b` (canonical MC numbering). -/
def mcEdgeVerts : Array (Nat × Nat) :=
  #[(0, 1), (1, 2), (2, 3), (3, 0),
    (4, 5), (5, 6), (6, 7), (7, 4),
    (0, 4), (1, 5), (2, 6), (3, 7)]

/-- The sign-change edges of a case index (`bit c ⇔ value < iso`, corner
    `c` is inside). -/
def signChangeEdges (k : Nat) : List Nat :=
  (List.finRange 12).filter fun e =>
    let (a, b) := mcEdgeVerts[e]!
    (k / 2 ^ a % 2) != (k / 2 ^ b % 2)

/-- The sign-change edge bitmask of a case, matching `MC_EDGE_TABLE`'s
    bit layout. -/
def signChangeEdgeMask (k : Nat) : Nat :=
  (signChangeEdges k).foldl (fun acc e => acc + 2 ^ e) 0

/-! ### The triangle list of a case -/

/-- The parsed triangles of a case: read up to the first `12`. -/
def trisOf (k : Nat) : List (Nat × Nat × Nat) :=
  go 0 []
where
  go (i : Nat) (acc : List (Nat × Nat × Nat)) : List (Nat × Nat × Nat) :=
    if i + 3 > 16 then acc
    else
      let a := (mcTriTable[k]!)[i]!
      if a = 12 then acc
      else go (i + 3) (acc ++ [(a, (mcTriTable[k]!)[i + 1]!, (mcTriTable[k]!)[i + 2]!)])
  termination_by 16 - i

/-- The mod-2 (odd-count) boundary edges of a case, seen as unordered
    pairs of cube edge ids. -/
def boundaryEdges (k : Nat) : List (Nat × Nat) :=
  let segs := (trisOf k).flatMap (fun (a, b, c) =>
    [(min a b, max a b), (min b c, max b c), (min c a, max c a)])
  segs.filter (fun e => segs.countP (fun e' => e' == e) == 1)

/-! ### The face table (corners and boundary edges, cyclic order) -/

/-- The 6 cube faces: 4 corner ids (cyclic, starting at the face's `000`
    corner) and the 4 boundary edge ids in the same cyclic order. -/
def faces : Array (Array Nat × Array Nat) :=
  #[(#[0, 1, 2, 3], #[0, 1, 2, 3]),
    (#[4, 5, 6, 7], #[4, 5, 6, 7]),
    (#[0, 1, 5, 4], #[0, 9, 4, 8]),
    (#[3, 2, 6, 7], #[2, 10, 6, 11]),
    (#[0, 3, 7, 4], #[3, 11, 7, 8]),
    (#[1, 2, 6, 5], #[1, 10, 5, 9])]

/-- The sign bits of a face's four corners, cyclic. -/
def faceSigns (k : Nat) (f : Array Nat) : List Nat :=
  f.toList.map fun c => k / 2 ^ c % 2

/-- Is the face ambiguous (checkerboard)? -/
def isAmbiguous (k : Nat) (f : Array Nat) : Bool :=
  let s := faceSigns k f
  s[0]! == s[2]! && s[1]! == s[3]! && s[0]! != s[1]!

/-- The four crossing points on an ambiguous face are the four sign-change
    edges of the face. -/
def faceCrossings (k : Nat) (f : Array Nat) : List Nat :=
  let fe := faces.find? (fun p => p.1 == f) |>.get!
  fe.2.toList.filter fun e =>
    let (a, b) := mcEdgeVerts[e]!
    (k / 2 ^ a % 2) != (k / 2 ^ b % 2)

/-- The pairing the table uses on an ambiguous face: `0` for the
    "inside-corner pair" grouping `(e01,e30)` and `(e12,e23)`, `1` for
    the complementary pairing. `none` when the table emits no segment
    on the face (the face is not crossed). -/
def pairingOf (k : Nat) (f : Array Nat) : Option Nat :=
  let fe := faces.find? (fun p => p.1 == f) |>.get!
  let edges := fe.2
  let used := (trisOf k).flatMap (fun (a, b, c) => [(min a b, max a b), (min b c, max b c), (min c a, max c a)])
  let has (e : Nat × Nat) := used.contains e
  let p (e : Nat × Nat) := has (min e.1 e.2, max e.1 e.2)
  let pairA := p (edges[0]!, edges[3]!) && p (edges[1]!, edges[2]!)
  let pairB := p (edges[0]!, edges[1]!) && p (edges[2]!, edges[3]!)
  if pairA then some 0 else if pairB then some 1 else none

/-! ### Machine-checked table theorems -/

/-- **T-MC-EDGE**: the edge table is exactly the sign-change mask of
    each case. -/
theorem mcEdgeTable_eq_signChange :
    ∀ k : Fin 256, mcEdgeTable[k]! = signChangeEdgeMask k.val := by
  native_decide

/-- Every non 12 id in a case's triangle table is a valid edge id. -/
theorem triIds_valid :
    ∀ k : Fin 256, (mcTriTable[k]!).toList.all (· < 13) := by
  native_decide

/-- The triangle table of every case terminates with the `12` terminator
    and only `12`s after it (well-formed padding). -/
theorem trisTerminated :
    ∀ k : Fin 256, (mcTriTable[k]!).toList.all (· < 13)
        ∧ (trisOf k.val).length ≤ 5 := by
  native_decide

/-- **T-MC-COUNT**: every case has at most 5 triangles. -/
theorem triCount_le_five : ∀ k : Fin 256, (trisOf k.val).length ≤ 5 := by
  native_decide

/-- **T-MC-COMPLETE**: every sign-change edge of every case is used by
    its emitted triangles — no dangling crossing. -/
theorem everySignChangeEdgeUsed :
    ∀ k : Fin 256, ∀ e ∈ signChangeEdges k.val,
      e ∈ (trisOf k.val).flatMap (fun (a, b, c) => [a, b, c]) := by
  native_decide

/-- **T-MC-NO-INVENT**: every edge the table emits is a sign-change
    edge of the case. -/
theorem everyUsedEdgeSignChange :
    ∀ k : Fin 256, ∀ e ∈ (trisOf k.val).flatMap (fun (a, b, c) => [a, b, c]),
      e ∈ signChangeEdges k.val := by
  native_decide

/-- **T-MC-BOUNDARY**: on every face of the cube, the mod-2 boundary
    edges of the emitted triangles lie on that face and pair exactly its
    sign-change edges — for all 256 cases. Implemented as a per-(case,
    face) decidable check. -/
def boundaryOk (k : Nat) (fe : Array Nat × Array Nat) : Bool :=
  let cross := fe.2.toList.filter fun e =>
    let (a, b) := mcEdgeVerts[e]!
    (k / 2 ^ a % 2) != (k / 2 ^ b % 2)
  let boundary := boundaryEdges k
  let onFace := boundary.filter (fun (a, b) => fe.2.toList.contains a && fe.2.toList.contains b)
  let used := onFace.flatMap (fun (a, b) => [a, b])
  cross.length = 2 * onFace.length && (cross.all (fun e => used.contains e))

theorem boundarySegments_on_faces :
    ∀ k : Fin 256, ∀ fe ∈ faces.toList, boundaryOk k.val fe = true := by
  native_decide

/-- The inside-corner pairing rule: pair by the sign of the face's
    `(0,2)` corners (`s0 == 1` corresponds to pairing A). -/
def insideCornerPairing (s : List Nat) : Nat := if s[0]! == 1 then 0 else 1

/-- **T-MC-FACE-CONSISTENT** (finding F10, machine-checked): on every
    ambiguous face instance in all 256 cases, the table pairs the four
    boundary crossing points by the *inside-corner* rule. Two cubes
    sharing a checkerboard face always agree — no diagonal crack. -/
def faceConsistentCheck : Bool :=
  faces.toList.all fun fe =>
    (List.range 256).all fun k =>
      let s := faceSigns k fe.1
      if isAmbiguous k fe.1 then
        match pairingOf k fe.1 with
        | some p => p == insideCornerPairing s
        | none => false
      else true

theorem faceConsistent : faceConsistentCheck = true := by
  native_decide

