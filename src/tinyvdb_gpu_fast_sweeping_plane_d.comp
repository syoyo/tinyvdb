#version 450
// fp64 twin of tinyvdb_gpu_fast_sweeping_plane.comp (tvdb_fast_sweeping_d).
//
// Structurally the fp32 kernel with double everywhere and tvdb__godunov_solve_d
// instead of tvdb__godunov_solve. Two details carry over and one changes:
//
//   * the wavefront/plane decomposition and the in-place update are unchanged,
//     and the reasoning for both is in the fp32 file;
//   * max_change still accumulates with an atomicMax, but over the **high 32
//     bits** of the value's IEEE-754 pattern, not all 64. GLSL has no uint64_t
//     (that needs ARB_gpu_shader_int64) and `union` is a reserved word, so the
//     64-bit pattern cannot be reinterpretted at all; the high word is instead
//     computed arithmetically with frexp. It is monotone in the value for
//     non-negative doubles, so the atomicMax is still a correct max, and the host
//     reconstructs a value good to 2^-20 relative. That is an *under*estimate
//     (the low 32 mantissa bits are dropped), so the only effect is that
//     convergence can be detected up to 1e-6 relative late, never early;
//   * GLSL has no `D` literal suffix (there is only `f` and `lf`), so the
//     constants are written plainly. That is correct here, not a slip: in GLSL an
//     unsuffixed floating literal is a *float*, and `2.0 * h` with a double `h`
//     promotes to double, so every expression below is evaluated in fp64. (The
//     fp32 file's note that "an unsuffixed GLSL literal is a double" has it
//     backwards; its `f` suffixes are harmless but unnecessary.)
//
// The CPU is Gauss-Seidel: within a sweep direction it walks voxels in index
// order and each update reads the *already updated* absphi value of its
// neighbour along the sweep direction. A plain parallel sweep would not
// reproduce that, so the host decomposes a sweep into wavefront planes and
// launches this kernel once per plane, in sweep order.
//
// Define the level of a voxel as L = dir.x*ix + dir.y*iy + dir.z*iz with
// dir in {-1,+1}. For sweep direction +1 a voxel reads its -1 neighbour, which is
// at level L-1 and has already been updated this sweep; for direction -1 it reads
// its +1 neighbour, at level L+1, which has not been updated yet and correctly
// still holds the pre-sweep value. Either way a voxel only ever reads levels
// strictly below L, so **every voxel on a plane is independent** and the plane is
// safe to do in parallel.
//
// Two consequences, both used here:
//   * The kernel updates `absphi` in place. No voxel in this plane reads another
//     voxel in this plane, so there is no intra-dispatch read-after-write hazard
//     and no ping-pong is needed.
//   * max_change accumulates on the device with atomicMax over the bit pattern.
//     For non-negative floats the IEEE-754 bit pattern orders the same way as the
//     value, so that is a correct max. That keeps the whole iteration to a single
//     readback instead of one per plane.
layout(local_size_x = 64, local_size_y = 1, local_size_z = 1) in;
layout(std430, set = 0, binding = 0) buffer PhiBuf { double phi[]; };
layout(std430, set = 0, binding = 1) buffer ChangeBuf { uint change_max[]; };
layout(std430, set = 0, binding = 2) readonly buffer FrozenBuf { uint frozen[]; };
layout(std140, set = 0, binding = 3) uniform Params {
  ivec4 dim;          // nx, ny, nz, unused
  ivec4 dir;          // sweep direction, each component -1 or +1
  int level;          // plane to process
  int pad0;           // keep the doubles 8-aligned
  double h;
  double huge;        // CPU's HUGE_D sentinel
  uint nvox;
  uint pad1;
} u;

int cl(int v, int n) { return v < 0 ? 0 : (v > n - 1 ? n - 1 : v); }

// High 32 bits of a non-negative double's IEEE-754 pattern. d = m * 2^e with
// m in [0.5, 1) after frexp, so doubling m puts it in [1, 2), the biased exponent
// is e + 1022, and the leading 20 mantissa bits are (m - 1) * 2^20 -- which is
// exactly the top half of the 64-bit pattern.
uint dbl_hi32(double d) {
  if (!(d > 0.0)) return 0u;
  int e; double m = frexp(d, e);
  m *= 2.0;
  return (uint(e + 1022) << 20) | uint((m - 1.0) * 1048576.0);
}

double at(int ix, int iy, int iz) {
  ix = cl(ix, u.dim.x); iy = cl(iy, u.dim.y); iz = cl(iz, u.dim.z);
  return phi[(uint(iz) * uint(u.dim.y) + uint(iy)) * uint(u.dim.x) + uint(ix)];
}

// tvdb__godunov_solve: a <= b <= c sorted and finite, h voxel size. 1D, then 2D,
// then 3D, falling back to the previous candidate on a negative discriminant
// exactly as the CPU does.
//
// The constants carry the `f` suffix on purpose: an unsuffixed GLSL literal is a
// double, so `2.0 * h * h` would evaluate the discriminant in double precision.
// This kernel is otherwise bit-exact with the CPU, down to the sweep order; the
// only residual difference is the sqrt itself, which the GLSL spec allows to be
// off by up to 2 ULP against libm's sqrtf. That bounds the worst-case relative
// error at roughly 5e-7, so parity is asserted with a float tolerance rather
// than by exact comparison.
double godunov(double a, double b, double c, double h) {
  double x = a + h;
  if (x <= b) return x;
  double ab = a + b;
  double disc = 2.0 * h * h - (a - b) * (a - b);
  if (disc < 0.0) return x;
  x = 0.5 * (ab + sqrt(disc));
  if (x <= c) return x;
  double abc = a + b + c;
  double sumsq = a * a + b * b + c * c;
  double disc3 = abc * abc - 3.0 * (sumsq - h * h);
  if (disc3 < 0.0) return x;
  return (abc + sqrt(disc3)) / 3.0;
}

double min2(double a, double b) { return a < b ? a : b; }

void main() {
  uint gid = gl_GlobalInvocationID.x;
  if (gid >= u.nvox) return;
  int nx = u.dim.x, ny = u.dim.y, nz = u.dim.z;
  int ix = int(gid) % nx;
  int iy = int(gid) / nx % ny;
  int iz = int(gid) / (nx * ny);

  if (u.dir.x * ix + u.dir.y * iy + u.dir.z * iz != u.level) return;
  if (frozen[gid] != 0u) return;

  double huge = u.huge;
  double ax = huge;
  if (ix > 0)      ax = min2(ax, at(ix - 1, iy, iz));
  if (ix + 1 < nx) ax = min2(ax, at(ix + 1, iy, iz));
  double ay = huge;
  if (iy > 0)      ay = min2(ay, at(ix, iy - 1, iz));
  if (iy + 1 < ny) ay = min2(ay, at(ix, iy + 1, iz));
  double az = huge;
  if (iz > 0)      az = min2(az, at(ix, iy, iz - 1));
  if (iz + 1 < nz) az = min2(az, at(ix, iy, iz + 1));

  double a = ax, b = ay, c = az;
  if (a > b) { double t = a; a = b; b = t; }
  if (b > c) { double t = b; b = c; c = t; }
  if (a > b) { double t = a; a = b; b = t; }
  if (a >= huge * 0.5) return;                 // CPU: `continue`

  double centre = at(ix, iy, iz);
  double new_v = godunov(a, b, c, u.h);
  if (new_v < centre) {
    phi[gid] = new_v;
    // ch = absphi[idx] - new_v, always >= 0, so the high word orders correctly.
    atomicMax(change_max[0], dbl_hi32(centre - new_v));
  }
}