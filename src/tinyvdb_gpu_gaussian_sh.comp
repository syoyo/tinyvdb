#version 450
layout(local_size_x = 128, local_size_y = 1, local_size_z = 1) in;
layout(std430, set = 0, binding = 0) readonly buffer ShBuffer { float sh[]; };
layout(std430, set = 0, binding = 1) readonly buffer DirBuffer { vec4 dirs[]; };
layout(std430, set = 0, binding = 2) buffer OutBuffer { float out_colors[]; };
layout(std140, set = 0, binding = 3) uniform Params {
  uint count;
  uint degree;
  uint K;
  uint pad;
} u;

// Real spherical-harmonics evaluation (3D Gaussian Splatting convention).
// sh[k] for gaussian g, channel c lives at sh[(g*K + k)*3 + c]; out = max(r+0.5, 0).
void main() {
  uint g = gl_GlobalInvocationID.x;
  if (g >= u.count) return;
  const float C0 = 0.28209479177387814;
  const float C1 = 0.4886025119029199;
  const float C2[5] = float[5](1.0925484305920792, -1.0925484305920792,
                               0.31539156525252005, -1.0925484305920792, 0.5462742152960396);
  const float C3[7] = float[7](-0.5900435899266435, 2.890611442640554, -0.4570457994644658,
                               0.3731763325901154, -0.4570457994644658, 1.445305721320277,
                               -0.5900435899266435);
  vec3 d = dirs[g].xyz;
  float len = length(d);
  d = (len > 1e-8) ? d / len : vec3(0.0);
  float dx = d.x, dy = d.y, dz = d.z;
  uint base = (g * u.K) * 3u;
  for (uint c = 0u; c < 3u; ++c) {
    uint b = base + c;          // sh[k] = sh[b + k*3]
    float r = C0 * sh[b];
    if (u.degree >= 1u) {
      r += C1 * (-dy * sh[b + 3u] + dz * sh[b + 6u] - dx * sh[b + 9u]);
      if (u.degree >= 2u) {
        float xx = dx*dx, yy = dy*dy, zz = dz*dz, xy = dx*dy, yz = dy*dz, xz = dx*dz;
        r += C2[0]*xy*sh[b + 12u] + C2[1]*yz*sh[b + 15u] + C2[2]*(2.0*zz-xx-yy)*sh[b + 18u]
           + C2[3]*xz*sh[b + 21u] + C2[4]*(xx-yy)*sh[b + 24u];
        if (u.degree >= 3u) {
          r += C3[0]*dy*(3.0*xx-yy)*sh[b + 27u] + C3[1]*xy*dz*sh[b + 30u]
             + C3[2]*dy*(4.0*zz-xx-yy)*sh[b + 33u] + C3[3]*dz*(2.0*zz-3.0*xx-3.0*yy)*sh[b + 36u]
             + C3[4]*dx*(4.0*zz-xx-yy)*sh[b + 39u] + C3[5]*dz*(xx-yy)*sh[b + 42u]
             + C3[6]*dx*(xx-3.0*yy)*sh[b + 45u];
        }
      }
    }
    r += 0.5;
    out_colors[g * 3u + c] = max(r, 0.0);
  }
}
