#version 450
layout(local_size_x = 128, local_size_y = 1, local_size_z = 1) in;
// Grid + weight storage are aliased as uint[] for a portable CAS-based atomic
// float add (no atomic-float extension required).
layout(std430, set = 0, binding = 0) buffer DataBuffer { uint data[]; };
layout(std430, set = 0, binding = 1) readonly buffer PointBuffer { vec4 points[]; };
layout(std430, set = 0, binding = 2) readonly buffer ValueBuffer { float vals[]; };
layout(std430, set = 0, binding = 3) buffer WeightBuffer { uint wdata[]; };
layout(std140, set = 0, binding = 4) uniform Params {
  ivec4 dim;        // nx, ny, nz, unused
  vec4 grid;        // ox, oy, oz, voxel_size
  uint count;
  uint has_weights;
} u;

void atomic_add_f(uint i, float v) {
  uint old = data[i], assumed;
  do { assumed = old;
       old = atomicCompSwap(data[i], assumed, floatBitsToUint(uintBitsToFloat(assumed) + v));
  } while (old != assumed);
}
void atomic_add_w(uint i, float v) {
  uint old = wdata[i], assumed;
  do { assumed = old;
       old = atomicCompSwap(wdata[i], assumed, floatBitsToUint(uintBitsToFloat(assumed) + v));
  } while (old != assumed);
}

// Quadratic basis weights for offsets (-1,0,1), the scatter adjoint of the
// 3-point parabola used by the quadratic sampler.
void quad_w3(float t, out float w0, out float w1, out float w2) {
  w0 = 0.5 * t * (t - 1.0);
  w1 = 1.0 - t * t;
  w2 = 0.5 * t * (t + 1.0);
}

// Triquadratic splat: scatter point values onto the grid (matches
// tvdb_splat_quadratic_dense). One thread per point; 3x3x3 accumulation uses
// portable CAS atomic-add. Grid (and weights) must be pre-uploaded.
void main() {
  uint p = gl_GlobalInvocationID.x;
  if (p >= u.count) return;
  int nx = u.dim.x, ny = u.dim.y, nz = u.dim.z;
  float vs = u.grid.w;
  vec3 pos = points[p].xyz;
  float cx = (pos.x - u.grid.x) / vs - 0.5;
  float cy = (pos.y - u.grid.y) / vs - 0.5;
  float cz = (pos.z - u.grid.z) / vs - 0.5;
  int ix = int(floor(cx)), iy = int(floor(cy)), iz = int(floor(cz));
  float tu = cx - float(ix), tv = cy - float(iy), tw = cz - float(iz);
  float wu[3], wv[3], ww[3];
  quad_w3(tu, wu[0], wu[1], wu[2]);
  quad_w3(tv, wv[0], wv[1], wv[2]);
  quad_w3(tw, ww[0], ww[1], ww[2]);
  float v = vals[p];
  for (int dz = 0; dz < 3; ++dz) {
    int z = iz - 1 + dz; if (z < 0 || z >= nz) continue;
    for (int dy = 0; dy < 3; ++dy) {
      int y = iy - 1 + dy; if (y < 0 || y >= ny) continue;
      for (int dx = 0; dx < 3; ++dx) {
        int x = ix - 1 + dx; if (x < 0 || x >= nx) continue;
        float w = wu[dx] * wv[dy] * ww[dz];
        uint idx = uint((z * ny + y) * nx + x);
        atomic_add_f(idx, w * v);
        if (u.has_weights != 0u) atomic_add_w(idx, w);
      }
    }
  }
}
