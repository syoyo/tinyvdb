#version 450
layout(local_size_x = 64, local_size_y = 1, local_size_z = 1) in;
layout(std430, set = 0, binding = 0) readonly buffer VertBuffer { float verts[]; };    // 9 floats/face (a,b,c)
layout(std430, set = 0, binding = 1) readonly buffer NormalBuffer { float normals[]; };// 3 floats/face
layout(std430, set = 0, binding = 2) buffer OutBuffer { float out_sdf[]; };
layout(std140, set = 0, binding = 3) uniform Params {
  // std140: dim 0..15, grid_o 16..31, band 32..35, face_count 36..39,
  // zrange 40..47, pad 48..55.
  ivec4 dim;       // nx, ny, nz, unused
  vec4 grid_o;     // ox, oy, oz, voxel_size
  float band;
  uint face_count;
  ivec2 zrange;    // first z slice, number of z slices
  ivec2 pad;
} u;

// Closest point on triangle abc to p (Ericson voronoi-region form, matching
// tri_closest_point_c). Also reports the closest feature: 0..2 = vertex a/b/c,
// 3..5 = edge ab/ac/bc, 6 = face interior -- the same tagging tri_closest_point_c
// emits, used for the pseudo-normal sign below.
vec3 tri_closest(vec3 p, vec3 a, vec3 b, vec3 c, out int feat) {
  feat = 6;
  vec3 ab = b - a, ac = c - a, ap = p - a;
  float d1 = dot(ab, ap), d2 = dot(ac, ap);
  if (d1 <= 0.0 && d2 <= 0.0) { feat = 0; return a; }
  vec3 bp = p - b;
  float d3 = dot(ab, bp), d4 = dot(ac, bp);
  if (d3 >= 0.0 && d4 <= d3) { feat = 1; return b; }
  float vc = d1*d4 - d3*d2;
  if (vc <= 0.0 && d1 >= 0.0 && d3 <= 0.0) { float v = d1 / (d1 - d3); feat = 3; return a + ab * v; }
  vec3 cp = p - c;
  float d5 = dot(ab, cp), d6 = dot(ac, cp);
  if (d6 >= 0.0 && d5 <= d6) { feat = 2; return c; }
  float vb = d5*d2 - d1*d6;
  if (vb <= 0.0 && d2 >= 0.0 && d6 <= 0.0) { float w = d2 / (d2 - d6); feat = 4; return a + ac * w; }
  float va = d3*d6 - d5*d4;
  if (va <= 0.0 && (d4 - d3) >= 0.0 && (d5 - d6) >= 0.0) { float w = (d4 - d3) / ((d4 - d3) + (d5 - d6)); feat = 5; return b + (c - b) * w; }
  float denom = 1.0 / (va + vb + vc);
  return a + ab * (vb * denom) + ac * (vc * denom);
}

// Brute-force mesh -> SDF (matches tvdb_mesh_to_sdf): one thread per voxel,
// closest-triangle distance with per-voxel normal sign, clamped to +/-band.
//
// The dispatch covers one slab of consecutive z slices, given by u.zrange, not
// the whole grid. Each thread writes to its true global voxel index, so slabs can
// be dispatched in any order and the result is identical to a single dispatch
// over the full grid. The host bounds a slab's voxel count because one dispatch
// over a 199^3 grid (8M threads, each scanning every face) is what previously
// came back as VK_ERROR_DEVICE_LOST.
void main() {
  uint gid = gl_GlobalInvocationID.x;
  int nx = u.dim.x, ny = u.dim.y;
  uint slice = uint(nx) * uint(ny);
  if (slice == 0u) return;
  uint total = slice * uint(u.zrange.y);
  if (gid >= total) return;
  int iz = u.zrange.x + int(gid) / int(slice);
  uint rem = gid - uint(iz - u.zrange.x) * slice;
  int iy = int(rem) / nx;
  int ix = int(rem) - iy * nx;
  vec3 p = u.grid_o.xyz + (vec3(ix, iy, iz) + 0.5) * u.grid_o.w;

  float best = 1e30;
  uint best_face = 0u;
  int best_feat = 6;
  vec3 best_cp = vec3(0.0), best_n = vec3(0.0);
  for (uint f = 0; f < u.face_count; ++f) {
    vec3 a = vec3(verts[9u*f+0u], verts[9u*f+1u], verts[9u*f+2u]);
    vec3 b = vec3(verts[9u*f+3u], verts[9u*f+4u], verts[9u*f+5u]);
    vec3 c = vec3(verts[9u*f+6u], verts[9u*f+7u], verts[9u*f+8u]);
    int feat;
    vec3 q = tri_closest(p, a, b, c, feat);
    vec3 d = p - q;
    float dsq = dot(d, d);
    if (dsq < best) {
      best = dsq; best_cp = q; best_face = f; best_feat = feat;
      best_n = vec3(normals[3u*f+0u], normals[3u*f+1u], normals[3u*f+2u]);
    }
  }
  // Pseudo-normal (Baerentzen & Aanaes), matching the CPU reference: the sign
  // uses the normal of the closest feature, not of the closest face. An edge or
  // vertex feature sums the normals of every face sharing it (coordinates equal
  // exactly -- vertex copies of the same point are stored bit-identically);
  // a face-interior feature keeps the face normal; a zero/degenerate sum falls
  // back to the face normal.
  vec3 n = best_n;
  if (best_feat < 6) {
    vec3 fa = vec3(verts[9u*best_face+0u], verts[9u*best_face+1u], verts[9u*best_face+2u]);
    vec3 fb = vec3(verts[9u*best_face+3u], verts[9u*best_face+4u], verts[9u*best_face+5u]);
    vec3 fc = vec3(verts[9u*best_face+6u], verts[9u*best_face+7u], verts[9u*best_face+8u]);
    vec3 wa, wb;
    if (best_feat <= 2) {
      wa = best_feat == 0 ? fa : (best_feat == 1 ? fb : fc);
    } else {
      if (best_feat == 3) { wa = fa; wb = fb; }
      else if (best_feat == 4) { wa = fa; wb = fc; }
      else { wa = fb; wb = fc; }
    }
    vec3 sum = vec3(0.0);
    for (uint g = 0; g < u.face_count; ++g) {
      vec3 ga = vec3(verts[9u*g+0u], verts[9u*g+1u], verts[9u*g+2u]);
      vec3 gb = vec3(verts[9u*g+3u], verts[9u*g+4u], verts[9u*g+5u]);
      vec3 gc = vec3(verts[9u*g+6u], verts[9u*g+7u], verts[9u*g+8u]);
      int count = 0;
      if (best_feat <= 2) {
        count = (ga == wa ? 1 : 0) + (gb == wa ? 1 : 0) + (gc == wa ? 1 : 0);
      } else {
        if ((ga == wa || gb == wa || gc == wa) && (ga == wb || gb == wb || gc == wb)) count = 1;
      }
      if (count > 0) sum += vec3(normals[3u*g+0u], normals[3u*g+1u], normals[3u*g+2u]);
    }
    float l2 = dot(sum, sum);
    if (!isnan(l2) && l2 > 0.0) n = sum / sqrt(l2);
  }
  float dist = sqrt(best);
  float s = dot(p - best_cp, n) >= 0.0 ? 1.0 : -1.0;
  float v = s * dist;
  v = clamp(v, -u.band, u.band);
  out_sdf[(uint(iz) * uint(ny) + uint(iy)) * uint(nx) + uint(ix)] = v;
}
