#version 450
layout(local_size_x = 128, local_size_y = 1, local_size_z = 1) in;
layout(std430, set = 0, binding = 0) readonly buffer ActiveBuffer { ivec4 act[]; };
layout(std430, set = 0, binding = 1) readonly buffer QueryBuffer  { ivec4 query[]; };
layout(std430, set = 0, binding = 2) buffer OutBuffer { int out_index[]; };
layout(std140, set = 0, binding = 3) uniform Params {
  uint na;
  uint nq;
} u;

// First-seen index of `q` in the active set, or -1. Linear scan (matches the
// sparse-conv kernel idiom); brute-force O(nq*na) but exact against the CPU
// reference. Scanning from i=0 yields the first-seen index like the CPU hash.
int lookup(ivec3 q) {
  for (uint i = 0; i < u.na; ++i) {
    if (act[i].xyz == q) return int(i);
  }
  return -1;
}

void main() {
  uint i = gl_GlobalInvocationID.x;
  if (i >= u.nq) return;
  out_index[i] = lookup(query[i].xyz);
}
