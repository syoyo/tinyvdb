#version 450
layout(local_size_x = 128, local_size_y = 1, local_size_z = 1) in;
layout(std430, set = 0, binding = 0) buffer ValBuffer { uint v2[]; };          // float bits, CAS atomic-add
layout(std430, set = 0, binding = 1) buffer OccBuffer { uint occ[]; };
layout(std430, set = 0, binding = 2) readonly buffer InBuffer { ivec4 in_data[]; };  // xyz coord, w = value bits
layout(std430, set = 0, binding = 3) readonly buffer KernelBuffer { float kernel[]; };
layout(std140, set = 0, binding = 4) uniform Params {
  ivec4 dims;    // bbox-local output dims
  ivec4 bbmin;   // output bbox minimum
  ivec4 kdim;    // kx, ky, kz
  int stride;
  uint n_in;
} u;

void add_f(uint i, float val) {
  uint old = v2[i], assumed;
  do { assumed = old;
       old = atomicCompSwap(v2[i], assumed, floatBitsToUint(uintBitsToFloat(assumed) + val));
  } while (assumed != old);
}

// Transposed (adjoint) sparse conv: each input voxel scatters kernel[k]*value
// to output coord ic*stride + tap_k, accumulating; marks output occupancy.
// One thread per input voxel; sparse_finalize then compacts.
void main() {
  uint i = gl_GlobalInvocationID.x;
  if (i >= u.n_in) return;
  ivec3 c = in_data[i].xyz;
  float v = intBitsToFloat(in_data[i].w);
  int ax = u.kdim.x / 2, ay = u.kdim.y / 2, az = u.kdim.z / 2;
  for (int dk = 0; dk < u.kdim.z; ++dk)
    for (int dj = 0; dj < u.kdim.y; ++dj)
      for (int di = 0; di < u.kdim.x; ++di) {
        uint ki = uint((dk * u.kdim.y + dj) * u.kdim.x + di);
        ivec3 oc = c * u.stride + ivec3(di - ax, dj - ay, dk - az) - u.bbmin.xyz;
        uint lin = uint((oc.z * u.dims.y + oc.y) * u.dims.x + oc.x);
        add_f(lin, kernel[ki] * v);
        occ[lin] = 1u;
      }
}
