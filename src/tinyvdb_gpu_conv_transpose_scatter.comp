#version 450
layout(local_size_x = 128, local_size_y = 1, local_size_z = 1) in;
layout(std430, set = 0, binding = 0) buffer ValBuffer { uint v2[]; };          // float bits, CAS atomic-add
layout(std430, set = 0, binding = 1) buffer OccBuffer { uint occ[]; };
layout(std430, set = 0, binding = 2) readonly buffer InBuffer { ivec4 in_data[]; };  // xyz coord, w = value bits
layout(std430, set = 0, binding = 3) readonly buffer KernelBuffer { float kernel[]; };
layout(std140, set = 0, binding = 4) uniform Params {
  ivec4 dims;    // bbox-local output dims
  ivec4 bbmin;   // output bbox minimum
  ivec4 kdim;    // kx, ky, kz
  int stride;
  uint n_in;
} u;

void add_f(uint i, float val) {
  uint old = atomicAdd(v2[i],0u), assumed;
  do { assumed = old;
       old = atomicCompSwap(v2[i], assumed, floatBitsToUint(uintBitsToFloat(assumed) + val));
  } while (assumed != old);
}

// Transposed (adjoint) sparse conv: each input voxel scatters kernel[k]*value
// to output coord ic*stride + tap_k, accumulating; marks output occupancy.
// One thread per input voxel; sparse_finalize then compacts.
// Unsigned magnitudes cover floor(coord/stride)*stride just below INT_MIN.
bool scaled_offset(int c,int scale,int d,out int q) {
  bool negative=c<0;
  uint mag=negative ? 0u-uint(c) : uint(c),factor=uint(scale);
  if(mag>0xffffffffu/factor) return false;
  mag*=factor;
  uint dm=d<0 ? 0u-uint(d) : uint(d);
  if((d<0)==negative) {
    uint limit=negative ? 2147483648u : 2147483647u;
    if(mag>limit || dm>limit-mag) return false;
    mag+=dm;
  } else if(dm>mag) { mag=dm-mag; negative=!negative; }
  else mag-=dm;
  if(mag>(negative ? 2147483648u : 2147483647u)) return false;
  q=int(negative ? 0u-mag : mag); return true;
}
void main() {
  uint i = gl_GlobalInvocationID.x;
  if (i >= u.n_in) return;
  ivec3 c = in_data[i].xyz;
  float v = intBitsToFloat(in_data[i].w);
  int ax = u.kdim.x / 2, ay = u.kdim.y / 2, az = u.kdim.z / 2;
  for (int dk = 0; dk < u.kdim.z; ++dk)
    for (int dj = 0; dj < u.kdim.y; ++dj)
      for (int di = 0; di < u.kdim.x; ++di) {
        uint ki = uint((dk * u.kdim.y + dj) * u.kdim.x + di);
        ivec3 q;
        if(!scaled_offset(c.x,u.stride,di-ax,q.x) || !scaled_offset(c.y,u.stride,dj-ay,q.y) || !scaled_offset(c.z,u.stride,dk-az,q.z)) continue;
        if(any(lessThan(q,u.bbmin.xyz)) || any(greaterThan(q,u.bbmin.xyz+u.dims.xyz-ivec3(1)))) continue;
        ivec3 oc=q-u.bbmin.xyz;
        uint lin = uint((oc.z * u.dims.y + oc.y) * u.dims.x + oc.x);
        add_f(lin, kernel[ki] * v);
        atomicOr(occ[lin],1u);
      }
}
