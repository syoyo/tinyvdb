#version 450
layout(local_size_x = 128, local_size_y = 1, local_size_z = 1) in;
layout(std430, set = 0, binding = 0) buffer DataBuffer { float data[]; };
layout(std140, set = 0, binding = 1) uniform Params {
  uint count;
  float background;
  float tolerance;
} u;

// Snap voxels within `tolerance` of the background exactly to it
// (matches tvdb_prune_grid).
void main() {
  uint i = gl_GlobalInvocationID.x;
  if (i >= u.count) return;
  if (abs(data[i] - u.background) <= u.tolerance) data[i] = u.background;
}
