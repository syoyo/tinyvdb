#version 450
// Active-set neighbour counts, via a host-built open-addressing ijk map instead
// of a linear scan of the active set per candidate neighbour.
//
// The original shader did up to 26 full scans of the active set for every
// active voxel, i.e. O(na^2 * connectivity). Probing a hash table makes it
// O(na * connectivity).
//
// The map is the same one tvdb_vk_index_map_build produces: `keys` is 3 x int32
// per slot, `values` is int32 holding (first_seen_index + 1) with 0 meaning
// "empty slot". Building it host-side is race-free and preserves first-seen
// ordering, which the linear scan also had.
layout(local_size_x = 128, local_size_y = 1, local_size_z = 1) in;
layout(std430, set = 0, binding = 0) readonly buffer KeyBuf   { int keys[]; };
layout(std430, set = 0, binding = 1) readonly buffer ValueBuf { int values[]; };
layout(std430, set = 0, binding = 2) readonly buffer ActiveBuffer { ivec4 act[]; };
layout(std430, set = 0, binding = 3) buffer OutBuffer { int out_counts[]; };
layout(std140, set = 0, binding = 4) uniform Params {
  uint na;
  int connectivity;  // 6 (face) or 26 (face+edge+vertex)
  uint cap;
  uint mask;         // cap - 1
  uint pad;
} u;


// Range-check before adding signed voxel offsets; never wrap across int32 ends.
bool offset_ok(ivec3 c,ivec3 d) {
  const int hi=2147483647,lo=(-2147483647-1);
  return (d.x>=0 ? c.x<=hi-d.x : c.x>=lo-d.x) &&
         (d.y>=0 ? c.y<=hi-d.y : c.y>=lo-d.y) &&
         (d.z>=0 ? c.z<=hi-d.z : c.z>=lo-d.z);
}
bool present(ivec3 q) {
  uint h = (uint(q.x) * 73856093u) ^ (uint(q.y) * 19349663u) ^ (uint(q.z) * 83492791u);
  uint slot = h & u.mask;
  for (uint probe = 0u; probe < u.cap; ++probe) {
    int v = values[slot];
    if (v == 0) return false;                 // empty slot: key absent
    if (keys[slot * 3u + 0u] == q.x && keys[slot * 3u + 1u] == q.y && keys[slot * 3u + 2u] == q.z)
      return true;
    slot = (slot + 1u) & u.mask;
  }
  return false;
}

void main() {
  uint i = gl_GlobalInvocationID.x;
  if (i >= u.na) return;
  ivec3 c = act[i].xyz;
  int cnt = 0;
  if (u.connectivity == 26) {
    for (int dz = -1; dz <= 1; ++dz)
      for (int dy = -1; dy <= 1; ++dy)
        for (int dx = -1; dx <= 1; ++dx) {
          if (dx == 0 && dy == 0 && dz == 0) continue;
          if ((offset_ok(c,ivec3(dx, dy, dz)) && present(c + ivec3(dx, dy, dz)))) ++cnt;
        }
  } else {
    if ((offset_ok(c,ivec3( 1, 0, 0)) && present(c + ivec3( 1, 0, 0)))) ++cnt;
    if ((offset_ok(c,ivec3(-1, 0, 0)) && present(c + ivec3(-1, 0, 0)))) ++cnt;
    if ((offset_ok(c,ivec3( 0, 1, 0)) && present(c + ivec3( 0, 1, 0)))) ++cnt;
    if ((offset_ok(c,ivec3( 0,-1, 0)) && present(c + ivec3( 0,-1, 0)))) ++cnt;
    if ((offset_ok(c,ivec3( 0, 0, 1)) && present(c + ivec3( 0, 0, 1)))) ++cnt;
    if ((offset_ok(c,ivec3( 0, 0,-1)) && present(c + ivec3( 0, 0,-1)))) ++cnt;
  }
  out_counts[i] = cnt;
}
