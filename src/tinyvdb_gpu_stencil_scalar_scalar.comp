#version 450
// Scalar -> scalar stencils: laplacian (op 0) and central differences
// (op 1 = dx, 2 = dy, 3 = dz).
//
// Matches the CPU reference exactly: reads clamped at the grid edge
// (tvdb_at), laplacian is the 7-point (sum of 6 neighbours - 6*centre) scaled by
// 1/h^2, and the central differences follow the CPU formula: one-sided
// difference over distance h at the boundary voxels (or 0 when the axis has a
// single cell), central difference over 2h in the interior. The host
// precomputes the scale (1/(2h)); the boundary path derives 1/h as 2*scale.
layout(local_size_x = 8, local_size_y = 8, local_size_z = 1) in;
layout(std430, set = 0, binding = 0) readonly buffer InBuffer  { float src[]; };
layout(std430, set = 0, binding = 1) buffer OutBuffer { float dst[]; };
layout(std140, set = 0, binding = 2) uniform Params {
  ivec4 dim;     // nx, ny, nz, op
  float scale;   // 1/h^2 for laplacian, 1/(2h) for central differences
  uint pad0;
  uint pad1;
  uint pad2;
} u;

int cl(int v, int n) { return v < 0 ? 0 : (v > n - 1 ? n - 1 : v); }
float at(int ix, int iy, int iz) {
  ix = cl(ix, u.dim.x); iy = cl(iy, u.dim.y); iz = cl(iz, u.dim.z);
  return src[(uint(iz) * uint(u.dim.y) + uint(iy)) * uint(u.dim.x) + uint(ix)];
}

void main() {
  ivec3 c = ivec3(gl_GlobalInvocationID.xy, 0u);
  int iz = int(gl_WorkGroupID.z);
  c.z = iz;
  if (c.x >= u.dim.x || c.y >= u.dim.y || c.z >= u.dim.z) return;
  uint i = (uint(c.z) * uint(u.dim.y) + uint(c.y)) * uint(u.dim.x) + uint(c.x);
  float v;
  if (u.dim.w == 0) {
    float s = at(c.x - 1, c.y, c.z) + at(c.x + 1, c.y, c.z)
            + at(c.x, c.y - 1, c.z) + at(c.x, c.y + 1, c.z)
            + at(c.x, c.y, c.z - 1) + at(c.x, c.y, c.z + 1);
    v = (s - 6.0 * at(c.x, c.y, c.z)) * u.scale;
  } else if (u.dim.w == 1) {
    int L = u.dim.x - 1;
    if (c.x <= 0)      v = (u.dim.x > 1) ? (at(1, c.y, c.z) - at(0, c.y, c.z)) * (u.scale * 2.0) : 0.0;
    else if (c.x >= L) v = (u.dim.x > 1) ? (at(L, c.y, c.z) - at(L - 1, c.y, c.z)) * (u.scale * 2.0) : 0.0;
    else               v = (at(c.x + 1, c.y, c.z) - at(c.x - 1, c.y, c.z)) * u.scale;
  } else if (u.dim.w == 2) {
    int L = u.dim.y - 1;
    if (c.y <= 0)      v = (u.dim.y > 1) ? (at(c.x, 1, c.z) - at(c.x, 0, c.z)) * (u.scale * 2.0) : 0.0;
    else if (c.y >= L) v = (u.dim.y > 1) ? (at(c.x, L, c.z) - at(c.x, L - 1, c.z)) * (u.scale * 2.0) : 0.0;
    else               v = (at(c.x, c.y + 1, c.z) - at(c.x, c.y - 1, c.z)) * u.scale;
  } else {
    int L = u.dim.z - 1;
    if (c.z <= 0)      v = (u.dim.z > 1) ? (at(c.x, c.y, 1) - at(c.x, c.y, 0)) * (u.scale * 2.0) : 0.0;
    else if (c.z >= L) v = (u.dim.z > 1) ? (at(c.x, c.y, L) - at(c.x, c.y, L - 1)) * (u.scale * 2.0) : 0.0;
    else               v = (at(c.x, c.y, c.z + 1) - at(c.x, c.y, c.z - 1)) * u.scale;
  }
  dst[i] = v;
}
