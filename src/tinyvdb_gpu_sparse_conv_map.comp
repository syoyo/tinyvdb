#version 450
// Sparse 3D convolution via a host-built open-addressing ijk map instead of a
// linear scan of the active set per kernel tap.
//
// The brute-force kernel did a full O(count) scan for every tap, i.e.
// O(count^2 * kx*ky*kz). Probing a hash table makes it O(count * kx*ky*kz).
//
// The map is one interleaved buffer, 4 x int32 per slot: (ix, iy, iz, v) where
// v is the first-seen active index plus one, and v == 0 marks an empty slot.
// The voxel value is then read from `values` at v-1, which reproduces the
// brute-force kernel's "first match wins" behaviour for duplicate coordinates
// exactly. Interleaving keeps a slot's key and occupancy in one cache line, and
// keeps the dispatch to 6 bindings -- the same descriptor count the other
// probe shaders use.
layout(local_size_x = 128, local_size_y = 1, local_size_z = 1) in;
layout(std430, set = 0, binding = 0) readonly buffer MapBuf { int map4[]; };   // (ix,iy,iz,v) per slot
layout(std430, set = 0, binding = 1) readonly buffer CoordBuffer { ivec4 coords[]; };
layout(std430, set = 0, binding = 2) readonly buffer ValueBuffer { float values[]; };
layout(std430, set = 0, binding = 3) readonly buffer KernelBuffer { float kernel[]; };
layout(std430, set = 0, binding = 4) buffer OutValueBuffer { float out_values[]; };
layout(std140, set = 0, binding = 5) uniform Params {
  uint count;
  uint cap;
  uint mask;      // cap - 1
  uint align_pad; // keeps kdim at offset 16 as std140 requires
  ivec4 kdim;
  float pad_value;
  uint pad0;
  uint pad1;
  uint pad2;
} u;

float lookup(ivec3 q) {
  uint h = (uint(q.x) * 73856093u) ^ (uint(q.y) * 19349663u) ^ (uint(q.z) * 83492791u);
  uint slot = h & u.mask;
  for (uint probe = 0u; probe < u.cap; ++probe) {
    int v = map4[slot * 4u + 3u];
    if (v == 0) return u.pad_value;            // empty slot: absent
    if (map4[slot * 4u + 0u] == q.x && map4[slot * 4u + 1u] == q.y && map4[slot * 4u + 2u] == q.z)
      return values[v - 1];                    // first-seen voxel value
    slot = (slot + 1u) & u.mask;
  }
  return u.pad_value;
}


// Range-check before adding signed voxel offsets; never wrap across int32 ends.
bool offset_ok(ivec3 c,ivec3 d) {
  const int hi=2147483647,lo=(-2147483647-1);
  return (d.x>=0 ? c.x<=hi-d.x : c.x>=lo-d.x) &&
         (d.y>=0 ? c.y<=hi-d.y : c.y>=lo-d.y) &&
         (d.z>=0 ? c.z<=hi-d.z : c.z>=lo-d.z);
}
void main() {
  uint i = gl_GlobalInvocationID.x;
  if (i >= u.count) return;
  ivec3 c = coords[i].xyz;
  int ax = u.kdim.x / 2;
  int ay = u.kdim.y / 2;
  int az = u.kdim.z / 2;
  float acc = 0.0;
  for (int dk = 0; dk < u.kdim.z; ++dk) {
    for (int dj = 0; dj < u.kdim.y; ++dj) {
      for (int di = 0; di < u.kdim.x; ++di) {
        acc += kernel[(dk * u.kdim.y + dj) * u.kdim.x + di] *
               (offset_ok(c,ivec3(di-ax,dj-ay,dk-az)) ? lookup(c + ivec3(di-ax,dj-ay,dk-az)) : u.pad_value);
      }
    }
  }
  out_values[i] = acc;
}
