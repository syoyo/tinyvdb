#version 450
layout(local_size_x = 256, local_size_y = 1, local_size_z = 1) in;
layout(std430, set = 0, binding = 0) readonly buffer ABuffer { float a[]; };
layout(std430, set = 0, binding = 1) readonly buffer BBuffer { float b[]; };
layout(std430, set = 0, binding = 2) buffer OutBuffer { float out_values[]; };
layout(std140, set = 0, binding = 3) uniform Params {
  uint count;
  int op;
} u;
void main() {
  uint i = gl_GlobalInvocationID.x;
  if (i >= u.count) return;
  float va = a[i];
  float vb = b[i];
  if (u.op == 0) {
    out_values[i] = min(va, vb);
  } else if (u.op == 1) {
    out_values[i] = max(va, vb);
  } else {
    out_values[i] = max(va, -vb);
  }
}
