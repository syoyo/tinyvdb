#version 450
layout(local_size_x = 128, local_size_y = 1, local_size_z = 1) in;
layout(std430, set = 0, binding = 0) buffer ValBuffer { uint v2[]; };       // float bits, CAS atomic-min
layout(std430, set = 0, binding = 1) buffer OccBuffer { uint outocc[]; };
layout(std430, set = 0, binding = 2) readonly buffer CoordBuffer { ivec4 coords[]; };
layout(std430, set = 0, binding = 3) readonly buffer InValBuffer { float invals[]; };
layout(std140, set = 0, binding = 4) uniform Params {
  ivec4 dims;    // bbox-local dims (active bbox expanded by 1)
  ivec4 bbmin;   // expanded bbox minimum
  uint count;
} u;

// Portable CAS atomic-min on a float aliased as uint.
void amin_f(uint i, float val) {
  uint old = v2[i], assumed;
  do {
    assumed = old;
    if (uintBitsToFloat(assumed) <= val) break;
    old = atomicCompSwap(v2[i], assumed, floatBitsToUint(val));
  } while (assumed != old);
}

// Dilate scatter (matches tvdb_dilate_sparse_step value semantics): each active
// voxel contributes its value (via min) to itself and its 6 face neighbors, and
// marks them as output-occupied. v2 is pre-seeded with background everywhere and
// each active voxel's own value, so the min folds in the base correctly.
void main() {
  uint i = gl_GlobalInvocationID.x;
  if (i >= u.count) return;
  int cx = coords[i].x - u.bbmin.x, cy = coords[i].y - u.bbmin.y, cz = coords[i].z - u.bbmin.z;
  float vs = invals[i];
  const ivec3 O[7] = ivec3[7](ivec3(0,0,0), ivec3(1,0,0), ivec3(-1,0,0), ivec3(0,1,0), ivec3(0,-1,0), ivec3(0,0,1), ivec3(0,0,-1));
  for (int k = 0; k < 7; ++k) {
    int qx = cx + O[k].x, qy = cy + O[k].y, qz = cz + O[k].z;
    uint lin = uint((qz * u.dims.y + qy) * u.dims.x + qx);
    amin_f(lin, vs);
    outocc[lin] = 1u;
  }
}
